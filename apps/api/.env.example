# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cofounderbay"

# JWT Authentication
JWT_ACCESS_SECRET="your-jwt-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# LinkedIn OAuth (https://www.linkedin.com/developers/)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_CALLBACK_URL="http://localhost:3001/api/auth/linkedin/callback"

# Email — verification, password reset and notifications. Without it those
# links are only written to the API log. Any SMTP server works (the sender may
# be EMAIL_FROM or SMTP_FROM; SMTP_SECURE=true for implicit TLS, implied by
# port 465). For SendGrid without SMTP_HOST: EMAIL_PROVIDER=sendgrid and
# SENDGRID_API_KEY (its SMTP relay is used).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@cofounderbay.com"
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY="SG.your-key"

# Uploads (optional)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Meilisearch (optional)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="your-meilisearch-key"
