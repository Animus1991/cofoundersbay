// CoFounderBay — source of truth
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  founder
  mentor
  investor
  org
  admin
  super_admin
}

// ── Multi-Role / Persona System ────────────────────────────────────────────────
// A user can have multiple role facets simultaneously (e.g., founder + mentor)

enum UserRoleType {
  aspiring_founder
  existing_founder
  cofounder_candidate
  technical_talent
  business_operator
  mentor
  advisor
  coach
  course_creator
  incubator_admin
  accelerator_admin
  university_admin
  venture_studio_admin
  angel_investor
  vc_scout
  vc_analyst
  syndicate_manager
  service_provider
  legal_partner
  finance_advisor
  recruiter
  platform_admin
}

enum RoleFacetScope {
  global
  tenant
  workspace
  community
  program
}

enum OrganizationType {
  incubator
  accelerator
  university
  venture_studio
  innovation_hub
  vc_fund
  angel_syndicate
  public_body
  service_provider
  corporate_innovation
  chamber
  cluster
  ngo
}

enum OrganizationMemberRole {
  owner
  admin
  program_manager
  mentor
  reviewer
  member
}

enum ProgramType {
  accelerator
  incubator
  course
  competition
  grant
  challenge
  bootcamp
  fellowship
}

enum ProgramStatus {
  draft
  upcoming
  active
  completed
  archived
}

enum ProgramParticipantRole {
  participant
  mentor
  judge
  organizer
  reviewer
  observer
}

enum ProgramParticipantStatus {
  applied
  accepted
  active
  completed
  dropped
  rejected
}

enum MentorAvailabilityStatus {
  available
  limited
  unavailable
  by_invitation
}

enum InvestorType {
  angel
  vc
  scout
  syndicate
  cvc
  family_office
  institutional
}

enum ServiceProviderType {
  legal
  accounting
  development
  design
  marketing
  recruiting
  consulting
  coaching
}

enum ConversationType {
  direct
  group
}

enum ConversationValidationMode {
  casual
  one_party
  two_party
}

enum UploadKind {
  avatar
  message_attachment
  event_attachment
  research_asset
}

enum ResearchNodeType {
  note
  document
  image
  pdf
  link
  reference // internal CoFounderBay entity reference
}

enum ResearchBoardVisibility {
  private
  team
  organization
  public
}

enum EventType {
  meetup
  webinar
  workshop
  demo_day
  networking
  other
}

enum RsvpStatus {
  going
  interested
  not_going
}

enum MeetingType {
  video
  in_person
  chat
}

enum BookingStatus {
  requested
  confirmed
  cancelled
  completed
}

enum NotificationType {
  message
  connection_request
  connection_accepted
  event_rsvp
  system
  billing
  mentor_request
  mentor_session_reminder
  mentor_review_received
  match_suggestion
  endorsement_received
  endorsement_request
  workspace_comment
  workspace_review
  workspace_invite
  program_application
  program_accepted
  program_rejected
  milestone_due
  milestone_completed
  group_invite
  group_post
  referral_converted
  follow_new
  ai_generation_complete
  expert_review_submitted
  coaching_session_reminder
  fundraising_update
}

enum ConnectionStatus {
  pending
  accepted
  declined
  blocked
}

enum ReportType {
  spam
  harassment
  fake
  inappropriate
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  paused
  canceled
  unpaid
  incomplete
  incomplete_expired
}

enum UserModerationStatus {
  active
  suspended
  banned
}

enum InviteStatus {
  pending
  accepted
  expired
  cancelled
}

enum GroupPrivacy {
  public
  private
  secret
}

enum GroupMemberRole {
  owner
  admin
  moderator
  member
}

model User {
  id                       String               @id @default(uuid())
  email                    String               @unique
  slug                     String               @unique
  passwordHash             String?
  role                     Role                 @default(founder)
  moderationStatus         UserModerationStatus @default(active)
  emailVerified            Boolean              @default(false)
  emailVerificationToken   String?              @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?              @unique
  passwordResetExpires     DateTime?
  hasCompletedOnboarding   Boolean              @default(false)
  lastSeenAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  refreshTokens RefreshToken[]
  profile       Profile?

  // OAuth providers
  googleId   String? @unique
  linkedinId String? @unique

  // Two-Factor Authentication
  twoFactorSecret      String?
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  // Messaging
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]
  validationsInitiated     ConversationValidation[]  @relation("ValidationInitiator")
  validationsAccepted      ConversationValidation[]  @relation("ValidationAcceptor")

  // Uploads
  uploads Upload[]

  // Social graph
  connectionsSent     ConnectionRequest[] @relation("ConnectionsSent")
  connectionsReceived ConnectionRequest[] @relation("ConnectionsReceived")

  // Events
  eventsCreated Event[]     @relation("EventsCreated")
  eventRsvps    EventRsvp[]

  // Mentoring
  mentorAvailabilities   MentorAvailability[]
  mentorBookingsAsMentor MentorBooking[]      @relation("MentorBookingsMentor")
  mentorBookingsAsMentee MentorBooking[]      @relation("MentorBookingsMentee")

  // Notifications
  notifications Notification[]

  // Moderation
  reportsFiled    Report[] @relation("ReportsFiled")
  reportsAgainst  Report[] @relation("ReportsAgainst")
  reportsResolved Report[] @relation("ReportsResolvedBy")

  // Billing
  subscriptions   Subscription[]
  seatAllocations SeatAllocation[]

  // Polls
  pollsCreated Poll[]     @relation("PollsCreated")
  pollVotes    PollVote[] @relation("PollVotes")

  // Jobs
  jobPostings JobPosting[] @relation("JobPostingsCreated")

  // Invites
  invitesSent     Invite[] @relation("InvitesSent")
  invitesReceived Invite[] @relation("InvitesReceived")

  // Groups
  groupsCreated      Group[]             @relation("GroupsCreated")
  groupMemberships   GroupMember[]
  groupPosts         GroupPost[]
  groupPostComments  GroupPostComment[]
  groupPostReactions GroupPostReaction[]

  // Phase 2: Analytics & Data
  profileViewsAsViewer ProfileView[]        @relation("ProfileViewsAsViewer")
  activities           UserActivity[]
  opportunities        Opportunity[]
  learningResources    LearningResource[]
  marketplaceServices  MarketplaceService[]
  cohortsOrganized     Cohort[]

  // Admin
  adminAuditLogs    AdminAuditLog[] @relation("AdminAuditLogs")
  cohortMemberships CohortMember[]

  // SSO / Multi-tenant
  userIdentities    UserIdentity[]
  tenantMemberships TenantMembership[]
  ssoAuthEvents     SSOAuthEvent[]

  // Milestones & Collaboration
  milestones       Milestone[] @relation("MilestonesOwned")
  milestoneCollabs Milestone[] @relation("MilestonesCollaborated")

  // Shortlist / Saved profiles
  savedProfiles SavedProfile[] @relation("SavedByUser")
  savedByUsers  SavedProfile[] @relation("UserSaved")

  // Endorsements
  endorsementsGiven    Endorsement[] @relation("EndorsementsGiven")
  endorsementsReceived Endorsement[] @relation("EndorsementsReceived")

  // Research Workspace
  researchBoardsOwned         ResearchBoard[]             @relation("ResearchBoardsOwned")
  researchBoardCollaborations ResearchBoardCollaborator[] @relation("ResearchBoardCollaborations")
  researchComments            ResearchComment[]           @relation("ResearchComments")

  // Startup Builder
  builderWorkspacesOwned      BuilderWorkspace[]          @relation("BuilderWorkspacesOwned")
  builderCollaborations       BuilderCollaborator[]       @relation("BuilderCollaborations")
  builderCommentsAuthored     BuilderComment[]            @relation("BuilderCommentsAuthored")
  builderSectionComments      BuilderSectionComment[]     @relation("BuilderSectionCommentsAuthored")
  builderReviewsRequested     BuilderReview[]             @relation("BuilderReviewsRequested")
  builderReviewsAssigned      BuilderReview[]             @relation("BuilderReviewsAssigned")
  builderAIGenerations        BuilderAIGeneration[]       @relation("BuilderAIGenerations")
  builderExports              BuilderExport[]             @relation("BuilderExports")
  builderActivities           BuilderActivityLog[]        @relation("BuilderActivities")

  // Multi-Role / Persona System
  roleFacets                  UserRoleFacet[]

  // Organization System
  organizationMemberships     OrganizationMembership[]
  organizationsCreated        Organization[]              @relation("OrganizationsCreated")
  organizationMentorRoles     OrganizationMentor[]

  // Program System
  programParticipations       ProgramParticipant[]
  programsCreated             Program[]                   @relation("ProgramsCreated")

  // Stakeholder Profiles
  mentorProfile               MentorProfile?
  investorProfile             InvestorProfile?
  serviceProviderProfile      ServiceProviderProfile?

  // Mentorship Relationships
  mentorshipsAsMentor         MentorshipRelationship[]    @relation("MentorshipAsMentor")
  mentorshipsAsMentee         MentorshipRelationship[]    @relation("MentorshipAsMentee")
  mentorshipSessionsAsMentor  MentorshipSession[]         @relation("SessionAsMentor")
  mentorshipSessionsAsMentee  MentorshipSession[]         @relation("SessionAsMentee")
  mentorRequestsSent          MentorRequest[]             @relation("MentorRequestsSent")
  mentorRequestsReceived      MentorRequest[]             @relation("MentorRequestsReceived")

  // Preferences & Matching
  userPreference              UserPreference?
  matchProfile                MatchProfile?
  userAchievements            UserAchievement[]
  onboardingProgress          OnboardingProgress?
  matchSuggestionsAsSource    MatchSuggestion[]           @relation("MatchSuggestionsAsSource")
  matchSuggestionsAsTarget    MatchSuggestion[]           @relation("MatchSuggestionsAsTarget")

  // Fundraising
  fundraisingRounds           FundraisingRound[]          @relation("FundraisingRoundOwner")
  pipelineLeadsAdded          InvestorPipelineLead[]      @relation("PipelineLeadsAdded")
  dataRoomDocsUploaded        DataRoomDocument[]          @relation("DataRoomDocsUploaded")

  // Coaching
  coachingSessionsAsCoach     CoachingSession[]           @relation("CoachingSessions_Coach")
  coachingSessionsAsClient    CoachingSession[]           @relation("CoachingSessions_Client")

  // Expert Reviews
  expertReviewsRequested      ExpertReview[]              @relation("ExpertReviews_Requester")
  expertReviewsAssigned       ExpertReview[]              @relation("ExpertReviews_Expert")

  // Service Marketplace
  serviceOffers               ServiceOffer[]              @relation("ServiceOffers_Provider")
  serviceInquiriesAsClient    ServiceInquiry[]            @relation("ServiceInquiries_Client")
  serviceInquiriesAsProvider  ServiceInquiry[]            @relation("ServiceInquiries_Provider")

  // Startup Snapshot (investor view)
  startupSnapshots            StartupSnapshot[]           @relation("StartupSnapshots")

  // Product Requirements
  productRequirementDocs      ProductRequirementDoc[]     @relation("PRDAuthor")

  // Startup Applications
  startupApplications         StartupApplication[]        @relation("ApplicationsSubmitted")

  // Workspace Comments
  workspaceComments           WorkspaceComment[]          @relation("WorkspaceCommentAuthor")

  // Billing & Usage
  paymentRecords              PaymentRecord[]             @relation("UserPayments")
  usageRecords                UsageRecord[]               @relation("UserUsageRecords")

  // Safety — Block system
  blocksGiven                 UserBlock[]                 @relation("BlocksGiven")
  blocksReceived              UserBlock[]                 @relation("BlocksReceived")

  // Audit log
  auditLogs                   AuditLog[]                  @relation("AuditLogsActor")

  // Skill endorsements
  skillEndorsementsGiven      SkillEndorsement[]          @relation("SkillEndorsementsGiven")
  skillEndorsementsReceived   SkillEndorsement[]          @relation("SkillEndorsementsReceived")

  // Referrals
  referralsMade               Referral[]                  @relation("ReferralsMade")
  referralsReceived           Referral[]                  @relation("ReferralsReceived")

  // Follow
  followers                   UserFollow[]                @relation("Followers")
  following                   UserFollow[]                @relation("Following")

  // Digest preference
  digestPreference            ActivityDigestPreference?   @relation("DigestPreference")

  // Portfolio
  portfolioItems              ProfilePortfolioItem[]      @relation("PortfolioItems")

  // AI Assistant
  aiAssistantSessions         AIAssistantSession[]        @relation("AIAssistantSessions")

  // Reputation
  reputationScore             UserReputationScore?        @relation("ReputationScore")

  // Readiness history
  readinessReports            StartupReadinessReport[]    @relation("ReadinessReports")

  // Data room access logs
  dataRoomAccesses            DataRoomAccessLog[]         @relation("DataRoomAccesses")

  // Notification channel preferences
  notificationChannels        UserNotificationChannel[]   @relation("NotificationChannels")

  // Calendar
  calendarEvents              CalendarEvent[]             @relation("CalendarEvents")

  // Public profile
  publicProfile               PublicProfile?              @relation("PublicProfile")

  // Feed system
  feedPosts                   FeedPost[]                  @relation("FeedPosts")
  feedComments                FeedComment[]               @relation("FeedComments")
  feedLikes                   FeedLike[]                  @relation("FeedLikes")
  feedBookmarks               FeedBookmark[]              @relation("FeedBookmarks")

  // Support tickets
  supportTickets              SupportTicket[]             @relation("SupportTickets")
  assignedTickets             SupportTicket[]             @relation("AssignedTickets")
  ticketMessages              TicketMessage[]             @relation("TicketMessages")

  // Saved searches
  savedSearches               SavedSearch[]               @relation("SavedSearches")

  // Platform announcements
  platformAnnouncements       PlatformAnnouncement[]      @relation("PlatformAnnouncements")
  announcementDismissals      AnnouncementDismissal[]     @relation("AnnouncementDismissals")

  @@index([role, moderationStatus])
  @@index([lastSeenAt])
  @@index([createdAt])
}

model Profile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  headline        String?
  bio             String? @db.Text
  location        String?
  timezone        String?
  languages       Json? // string[] e.g. ["en", "el"]
  avatarUrl       String?
  rolePayload     Json? // role-specific: industry, stage, expertiseAreas, checkSize, etc.
  visibilityRules Json? // { email?: "public"|"connections"|"private", ... }

  // Organization-specific fields
  tagline  String?
  website  String?
  mission  String? @db.Text
  industry String?
  focus    String? // comma-separated focus areas
  size     String? // organization size

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  skills    ProfileSkill[]

  // Phase 2: Analytics
  views ProfileView[]

  @@index([location])
  @@index([createdAt])
}

model Skill {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  category  String? // e.g. "technical", "business", "design"
  createdAt DateTime       @default(now())
  profiles  ProfileSkill[]
}

model ProfileSkill {
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     String? // "beginner" | "intermediate" | "expert" (optional)
  createdAt DateTime @default(now())

  @@id([profileId, skillId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  deviceInfo String?
}

model Conversation {
  id            String                    @id @default(uuid())
  type          ConversationType          @default(direct)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessageAt DateTime?
  participants  ConversationParticipant[]
  messages      Message[]
  validation    ConversationValidation?
}

model ConversationValidation {
  id                  String                     @id @default(uuid())
  conversationId      String                     @unique
  conversation        Conversation               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mode                ConversationValidationMode @default(casual)
  initiatedById       String?
  initiatedBy         User?                      @relation("ValidationInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  initiatedAt         DateTime?
  acceptedById        String?
  acceptedBy          User?                      @relation("ValidationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt          DateTime?
  lastValidatedAt     DateTime?
  validationHash      String?                    @db.Text
  transcriptAvailable Boolean                    @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([conversationId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  isPinned       Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isMuted        Boolean      @default(false)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String              @id @default(uuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String              @db.Text
  createdAt      DateTime            @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  readAt         DateTime?
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadId  String?
  upload    Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  url       String
  mimeType  String?
  fileName  String?
  sizeBytes Int?
}

model Upload {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         UploadKind
  key          String
  url          String
  mimeType     String?
  originalName String?
  sizeBytes    Int?
  createdAt    DateTime   @default(now())

  messageAttachments MessageAttachment[]
  researchNodes      ResearchNode[]

  @@index([userId])
  @@index([kind])
}

model ConnectionRequest {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  requester   User             @relation("ConnectionsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  message     String?          @db.Text
  status      ConnectionStatus @default(pending)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

model Event {
  id            String      @id @default(uuid())
  creatorId     String
  creator       User        @relation("EventsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  title         String
  description   String?     @db.Text
  type          EventType   @default(networking)
  startAt       DateTime
  endAt         DateTime?
  timezone      String?
  location      String?
  isOnline      Boolean     @default(false)
  meetingUrl    String?
  capacity      Int?
  coverImageUrl String?
  isFeatured    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rsvps         EventRsvp[]

  @@index([startAt])
  @@index([creatorId])
  @@index([isFeatured])
}

model EventRsvp {
  eventId     String
  userId      String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RsvpStatus @default(going)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  checkedInAt DateTime?

  @@id([eventId, userId])
  @@index([userId])
}

model MentorAvailability {
  id        String   @id @default(uuid())
  mentorId  String
  mentor    User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  weekday   Int // 0-6
  startTime String // "09:00"
  endTime   String
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentorId])
}

model MentorBooking {
  id                    String        @id @default(uuid())
  mentorId              String
  mentor                User          @relation("MentorBookingsMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId              String
  mentee                User          @relation("MentorBookingsMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  startAt               DateTime
  endAt                 DateTime
  timezone              String?
  meetingType           MeetingType   @default(video)
  meetingUrl            String?
  notes                 String?       @db.Text
  status                BookingStatus @default(requested)
  priceCents            Int?
  currency              String?       @default("USD")
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([mentorId, startAt])
  @@index([menteeId, startAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  meta      Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Report {
  id             String       @id @default(uuid())
  type           ReportType
  status         ReportStatus @default(pending)
  reporterId     String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId     String
  reported       User         @relation("ReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)
  reason         String       @db.Text
  context        Json?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?        @relation("ReportsResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reportedId, status])
}

model Poll {
  id        String       @id @default(uuid())
  creatorId String
  creator   User         @relation("PollsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  question  String       @db.Text
  isActive  Boolean      @default(true)
  endsAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  options   PollOption[]
  votes     PollVote[]

  @@index([isActive, createdAt])
}

model PollOption {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String     @db.Text
  sortOrder Int        @default(0)
  votes     PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String
  optionId  String
  userId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation("PollVotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
}

model JobPosting {
  id          String   @id @default(uuid())
  creatorId   String
  creator     User     @relation("JobPostingsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  role        String? // e.g. "Founder", "Technical Co-Founder"
  location    String?
  isRemote    Boolean  @default(false)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, createdAt])
  @@index([isFeatured])
}

model Invite {
  id           String       @id @default(uuid())
  senderId     String
  sender       User         @relation("InvitesSent", fields: [senderId], references: [id], onDelete: Cascade)
  email        String
  message      String?      @db.Text
  status       InviteStatus @default(pending)
  acceptedById String?
  acceptedBy   User?        @relation("InvitesReceived", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([email])
  @@index([status])
}

// Groups/Communities System
model Group {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  description   String?      @db.Text
  avatarUrl     String?
  coverImageUrl String?
  privacy       GroupPrivacy @default(public)
  category      String?
  tags          Json?
  rules         Json?
  isFeatured    Boolean      @default(false)
  createdById   String
  createdBy     User         @relation("GroupsCreated", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  members GroupMember[]
  posts   GroupPost[]
  events  GroupEvent[]

  @@index([slug])
  @@index([privacy])
  @@index([category])
  @@index([createdAt])
  @@index([isFeatured])
}

model GroupMember {
  id       String          @id @default(uuid())
  groupId  String
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupMemberRole @default(member)
  joinedAt DateTime        @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupPost {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String    @db.Text
  mediaUrls Json?
  isPinned  Boolean   @default(false)
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  comments  GroupPostComment[]
  reactions GroupPostReaction[]

  @@index([groupId, createdAt])
  @@index([authorId])
}

model GroupPostComment {
  id        String    @id @default(uuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String    @db.Text
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
}

model GroupPostReaction {
  id        String    @id @default(uuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model GroupEvent {
  id          String    @id @default(uuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  startDate   DateTime
  endDate     DateTime?
  location    String?
  isVirtual   Boolean   @default(false)
  meetingUrl  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([groupId, startDate])
}

// ============================================
// Phase 2: Data Layer Completion & Analytics
// ============================================

enum ProfileViewSource {
  direct
  search
  recommendation
  group
  event
  external
}

enum UserActivityType {
  profile_view
  connection_sent
  connection_accepted
  message_sent
  event_created
  event_rsvp
  group_joined
  post_created
  login
  profile_updated
}

enum OpportunityType {
  job
  cofounder
  investment
  partnership
  mentorship
  other
}

enum LearningResourceType {
  article
  video
  course
  podcast
  book
  tool
  template
}

enum LearningDifficulty {
  beginner
  intermediate
  advanced
}

enum MarketplaceCategory {
  legal
  finance
  marketing
  development
  design
  consulting
  coaching
  other
}

// Track profile views for analytics
model ProfileView {
  id        String            @id @default(uuid())
  profileId String
  profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  viewerId  String? // nullable for anonymous views
  viewer    User?             @relation("ProfileViewsAsViewer", fields: [viewerId], references: [id], onDelete: SetNull)
  source    ProfileViewSource @default(direct)
  referrer  String? // URL or context
  createdAt DateTime          @default(now())

  @@index([profileId, createdAt])
  @@index([viewerId])
}

// Track user activity for analytics and recommendations
model UserActivity {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       UserActivityType
  entityId   String? // ID of related entity (profile, event, group, etc.)
  entityType String? // "profile", "event", "group", etc.
  meta       Json? // Additional context
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([entityId])
}

// Opportunities (jobs, co-founder searches, investments, etc.)
model Opportunity {
  id          String          @id @default(uuid())
  title       String
  description String?         @db.Text
  type        OpportunityType @default(job)
  company     String?
  location    String?
  isRemote    Boolean         @default(false)
  url         String? // External application URL
  tags        Json? // string[]
  deadline    DateTime?
  isActive    Boolean         @default(true)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, isActive])
  @@index([createdById])
  @@index([createdAt])
}

// Learning resources (articles, videos, courses, etc.)
model LearningResource {
  id          String               @id @default(uuid())
  title       String
  description String?              @db.Text
  type        LearningResourceType @default(article)
  category    String? // "fundraising", "product", "marketing", etc.
  url         String
  author      String?
  duration    Int? // minutes for video/course
  difficulty  LearningDifficulty   @default(beginner)
  tags        Json? // string[]
  imageUrl    String?
  isFeatured  Boolean              @default(false)
  isActive    Boolean              @default(true)
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([type, isActive])
  @@index([category])
  @@index([isFeatured])
  @@index([createdAt])
}

// Marketplace services (legal, finance, marketing, etc.)
model MarketplaceService {
  id           String              @id @default(uuid())
  title        String
  description  String?             @db.Text
  category     MarketplaceCategory @default(other)
  providerName String
  providerLogo String?
  pricing      String? // "Free", "$99/mo", "Custom", etc.
  contactUrl   String?
  websiteUrl   String?
  tags         Json? // string[]
  isFeatured   Boolean             @default(false)
  isActive     Boolean             @default(true)
  createdById  String
  createdBy    User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([category, isActive])
  @@index([isFeatured])
  @@index([createdAt])
}

// Cohorts/Programs for B2B functionality
model Cohort {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  organizerId String
  organizer   User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int?
  isPublic    Boolean   @default(true)
  tags        Json? // string[]
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members CohortMember[]

  @@index([slug])
  @@index([organizerId])
  @@index([isPublic, isActive])
}

model CohortMember {
  id       String   @id @default(uuid())
  cohortId String
  cohort   Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("participant") // "participant", "mentor", "organizer"
  joinedAt DateTime @default(now())

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
}

// ── White-label / Multi-tenant ──────────────────────────────────────────────

enum TenantStatus {
  draft
  active
  suspended
}

model Tenant {
  id               String       @id @default(uuid())
  slug             String       @unique
  name             String
  displayName      String?
  shortDescription String?
  description      String?      @db.Text
  aboutText        String?      @db.Text
  website          String?
  logoUrl          String?
  faviconUrl       String?
  status           TenantStatus @default(draft)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  branding          TenantBranding?
  ssoConfig         TenantSSOConfig?
  identityProviders IdentityProvider[]
  memberships       TenantMembership[]
  domainMappings    DomainMapping[]
  tenantDomains     TenantDomain[]
  automationRules   AutomationRule[]
  automationConfig  TenantAutomationConfig?
  organizations     Organization[]
  featureFlags      TenantFeatureFlag[]
  webhooks          Webhook[]
  apiKeys           ApiKey[]
  announcements     Announcement[]

  @@index([slug])
  @@index([status])
}

model TenantBranding {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Colors
  primaryColor    String? // hex, e.g. "#6366f1"
  secondaryColor  String?
  accentColor     String?
  backgroundStyle String? // "gradient" | "flat" | "image" | "dark"

  // Typography
  headingFont String? // e.g. "Inter", "Poppins", "Playfair Display"
  bodyFont    String? // e.g. "Inter", "Roboto", "Open Sans"

  // Media
  heroImageUrl String? // Hero banner / background image
  websiteUrl   String? // Tenant website URL (for branding footer)

  // Content
  heroTitle            String?
  heroSubtitle         String?
  aboutText            String? @db.Text // Long-form about section on landing page
  ctaLabel             String? @default("Get Started")
  ctaUrl               String? // Where CTA button redirects
  onboardingIntroText  String? @db.Text
  dashboardWelcomeText String?

  // Custom naming / labels
  communityNaming String? // Custom label for "community" e.g. "Program", "Cohort"
  roleLabels      Json? // { "founder": "Entrepreneur", "mentor": "Advisor", ... }

  // Contact & legal
  supportEmail     String?
  privacyPolicyUrl String?
  termsUrl         String?
  cookiePolicyUrl  String?

  // Social
  linkedinUrl      String?
  twitterUrl       String?
  instagramUrl     String?
  websiteFooterUrl String?

  // Email
  emailSignature  String? @db.Text
  emailLogoUrl    String?
  emailFooterText String? @db.Text
  emailFromName   String? // Sender display name for tenant emails

  isBrandingActive Boolean   @default(false)
  publishedAt      DateTime?
  updatedAt        DateTime  @updatedAt
}

// ── Enterprise SSO / Identity Provider ─────────────────────────────────────

enum SSOProviderType {
  saml
  oidc
  oauth2
}

enum SSOMode {
  disabled // No SSO for this tenant
  optional // Users can choose SSO or password
  required // SSO mandatory for tenant members
}

model IdentityProvider {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Provider config
  providerType SSOProviderType
  providerName String // Display name, e.g. "University of Athens SSO"
  isActive     Boolean         @default(false)

  // SAML config
  samlEntryPoint  String? // IdP SSO URL
  samlIssuer      String? // IdP Entity ID
  samlCert        String? @db.Text // IdP X.509 certificate
  samlMetadataUrl String? // IdP metadata URL for auto-config

  // OIDC/OAuth2 config
  oidcIssuerUrl        String? // e.g. https://accounts.google.com
  oidcClientId         String?
  oidcClientSecret     String? // encrypted in production
  oidcScopes           String? @default("openid profile email")
  oidcAuthorizationUrl String?
  oidcTokenUrl         String?
  oidcUserInfoUrl      String?

  // UI customization
  loginButtonText  String? @default("Continue with SSO")
  loginButtonColor String? // hex color
  logoUrl          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ssoConfig      TenantSSOConfig?
  userIdentities UserIdentity[]
  authEvents     SSOAuthEvent[]

  @@unique([tenantId, providerType])
  @@index([tenantId])
  @@index([isActive])
}

model TenantSSOConfig {
  id                 String            @id @default(uuid())
  tenantId           String            @unique
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identityProviderId String?           @unique
  identityProvider   IdentityProvider? @relation(fields: [identityProviderId], references: [id], onDelete: SetNull)

  // SSO mode
  ssoMode SSOMode @default(disabled)

  // Domain restrictions
  allowedDomains     String[] // e.g. ["uoa.gr", "di.uoa.gr"]
  enforceEmailDomain Boolean  @default(true)

  // Auto-provisioning (JIT)
  autoProvisionEnabled Boolean @default(false)
  defaultRole          String  @default("founder")
  autoAssignToTenant   Boolean @default(true)

  // Role mapping rules (JSON array)
  roleMappingRules Json? // e.g. [{ claim: "groups", value: "admins", role: "admin" }]

  // Post-login behavior
  postLoginRedirect        String? // Custom redirect URL after SSO login
  requireProfileCompletion Boolean @default(true)

  // Security
  sessionDurationHours  Int     @default(24)
  allowPasswordFallback Boolean @default(false) // Allow password login even with SSO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([ssoMode])
}

model UserIdentity {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityProviderId String
  identityProvider   IdentityProvider @relation(fields: [identityProviderId], references: [id], onDelete: Cascade)

  // External identity
  externalId  String // Subject/NameID from IdP
  email       String? // Email from IdP claims
  displayName String? // Name from IdP claims
  rawClaims   Json? // Full claims for debugging

  // Status
  isLinked    Boolean   @default(true)
  linkedAt    DateTime  @default(now())
  lastLoginAt DateTime?

  @@unique([identityProviderId, externalId])
  @@index([userId])
  @@index([identityProviderId])
  @@index([email])
}

model TenantMembership {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Role within tenant
  role String @default("member") // "member", "admin", "owner"

  // Status
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  invitedBy String? // userId of inviter

  // SSO-specific
  provisionedViaSSO Boolean   @default(false)
  lastSSOLoginAt    DateTime?

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([isActive])
}

model DomainMapping {
  id       String @id @default(uuid())
  domain   String @unique // e.g. "uoa.gr" - email domain for SSO discovery
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Auto-discovery
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  // Behavior
  autoRedirectToSSO Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([domain])
  @@index([tenantId])
}

// ── Tenant Domain Routing (Subdomains & Custom Domains) ───────────────────────

enum TenantDomainType {
  subdomain // e.g. athens.cofounderbay.com
  custom // e.g. founders.university.edu
}

enum DomainVerificationStatus {
  pending
  verified
  failed
  expired
}

model TenantDomain {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Domain configuration
  domainType TenantDomainType
  domainName String           @unique // Full domain, e.g. "athens.cofounderbay.com" or "founders.uni.edu"
  isPrimary  Boolean          @default(false)
  isActive   Boolean          @default(false)

  // SSL/TLS
  sslStatus    String? // "pending", "active", "failed"
  sslExpiresAt DateTime?

  // Verification (for custom domains)
  verificationStatus    DomainVerificationStatus @default(pending)
  verificationToken     String? // DNS TXT record value
  verificationMethod    String? // "dns_txt", "dns_cname", "file"
  dnsInstructions       String?                  @db.Text // JSON instructions for DNS setup
  verifiedAt            DateTime?
  lastVerificationCheck DateTime?

  // Routing behavior
  redirectBehavior     String? @default("none") // "none", "redirect_to_primary", "redirect_to_main"
  customLandingEnabled Boolean @default(true)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([domainName])
  @@index([domainType])
  @@index([isActive])
}

// ── Billing & Subscriptions ───────────────────────────────────────────────────

enum BillingCycle {
  monthly
  annual
}

enum PlanType {
  free
  individual_premium
  organization
  enterprise
}

model BillingPlan {
  id String @id @default(uuid())

  // Plan identity
  name        String   @unique // e.g. "free", "pro", "team", "enterprise"
  displayName String // e.g. "Free", "Pro", "Team", "Enterprise"
  description String?  @db.Text
  planType    PlanType

  // Pricing
  priceMonthly Int    @default(0) // in cents
  priceAnnual  Int    @default(0) // in cents
  currency     String @default("USD")

  // Limits
  seatLimit Int? // null = unlimited
  storageGb Int  @default(1)

  // Feature flags (JSON object)
  features Json // e.g. { "sso": true, "whiteLabel": true, "analytics": "advanced" }

  // Visibility
  isPublic  Boolean @default(true)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // Stripe/Payment provider
  stripeProductId      String?
  stripePriceIdMonthly String?
  stripePriceIdAnnual  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscriptions Subscription[]

  @@index([planType])
  @@index([isActive])
}

model Subscription {
  id String @id @default(uuid())

  // Owner (either user or tenant)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String?
  // Note: Tenant relation added via tenantSubscriptions on Tenant model

  // Plan
  planId       String
  plan         BillingPlan  @relation(fields: [planId], references: [id])
  billingCycle BillingCycle @default(monthly)

  // Status
  status SubscriptionStatus @default(trialing)

  // Dates
  startDate          DateTime  @default(now())
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  trialStart         DateTime?
  trialEnd           DateTime?
  canceledAt         DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Seats (for organization plans)
  seatLimit       Int?
  activeSeatCount Int  @default(1)

  // Payment provider
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invoices        Invoice[]
  seatAllocations SeatAllocation[]
  payments        PaymentRecord[]

  @@index([userId])
  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model SeatAllocation {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Status
  isActive      Boolean   @default(true)
  allocatedAt   DateTime  @default(now())
  deactivatedAt DateTime?

  // Metadata
  allocatedBy String? // userId of allocator

  @@unique([subscriptionId, userId])
  @@index([subscriptionId])
  @@index([userId])
  @@index([isActive])
}

model Invoice {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Invoice details
  invoiceNumber String @unique
  status        String @default("draft") // "draft", "open", "paid", "void", "uncollectible"

  // Amounts (in cents)
  subtotal   Int    @default(0)
  tax        Int    @default(0)
  total      Int    @default(0)
  amountPaid Int    @default(0)
  amountDue  Int    @default(0)
  currency   String @default("USD")

  // Dates
  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime?
  paidAt      DateTime?

  // Billing details
  billingName    String?
  billingEmail   String?
  billingAddress Json? // { line1, line2, city, state, postalCode, country }
  taxId          String? // VAT number

  // Payment provider
  stripeInvoiceId       String?
  stripePaymentIntentId String?
  hostedInvoiceUrl      String?
  invoicePdf            String?

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lines InvoiceLine[]

  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Line item
  description String
  quantity    Int    @default(1)
  unitAmount  Int // in cents
  amount      Int // quantity * unitAmount

  // Period
  periodStart DateTime?
  periodEnd   DateTime?

  // Metadata
  metadata Json?

  @@index([invoiceId])
}

model PromotionCode {
  id   String @id @default(uuid())
  code String @unique

  // Discount
  discountType  String // "percent", "fixed"
  discountValue Int // percentage or cents
  currency      String? @default("USD") // for fixed discounts

  // Restrictions
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?

  // Applicability
  applicablePlans String[] // plan IDs, empty = all plans
  firstTimeOnly   Boolean  @default(false)

  // Status
  isActive Boolean @default(true)

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([code])
  @@index([isActive])
}

model SSOAuthEvent {
  id                 String           @id @default(uuid())
  identityProviderId String
  identityProvider   IdentityProvider @relation(fields: [identityProviderId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Event details
  eventType  String // "login_success", "login_failure", "logout", "provision", "link"
  email      String?
  externalId String?

  // Context
  ipAddress    String?
  userAgent    String?
  errorCode    String?
  errorMessage String?

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([identityProviderId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

// ── Automation Framework ──────────────────────────────────────────────────

enum AutomationTriggerType {
  user_signup
  onboarding_incomplete
  profile_incomplete
  match_generated
  match_not_viewed
  connection_request_sent
  connection_not_answered
  connection_accepted
  mentor_request_submitted
  mentor_request_accepted
  mentor_session_idle
  community_join
  community_inactive
  content_reported_threshold
  tenant_setup_incomplete
  subscription_trial_ending
  subscription_failed_payment
  subscription_canceled
  subscription_seat_limit
  user_inactive
  scheduled
  manual
}

enum AutomationActionType {
  send_email
  send_in_app_notification
  generate_matches
  flag_for_admin_review
  send_admin_alert
  update_user_field
  trigger_another_rule
  log_event
  webhook_call
}

enum AutomationStatus {
  draft
  active
  paused
  archived
}

enum AutomationExecutionStatus {
  pending
  running
  completed
  failed
  skipped
  cancelled
}

enum ScheduledJobStatus {
  pending
  processing
  completed
  failed
  cancelled
}

model AutomationRule {
  id       String  @id @default(uuid())
  tenantId String? // null = global platform rule
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name               String
  description        String?               @db.Text
  triggerType        AutomationTriggerType
  conditionDef       Json? // [{ field, operator, value }]
  actionDef          Json // { type, params }
  delaySeconds       Int                   @default(0)
  scheduleExpression String? // cron expression for scheduled triggers

  status   AutomationStatus @default(draft)
  priority Int              @default(100)

  executionCount Int       @default(0)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  failureCount   Int       @default(0)
  maxFailures    Int       @default(10)

  createdBy String? // userId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions AutomationExecution[]

  @@index([tenantId])
  @@index([triggerType])
  @@index([status])
  @@index([nextRunAt])
}

model AutomationExecution {
  id     String         @id @default(uuid())
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  targetUserId     String?
  targetEntityType String? // "user", "tenant", "connection", etc.
  targetEntityId   String?

  status      AutomationExecutionStatus @default(pending)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  result       Json?
  errorMessage String? @db.Text
  retryCount   Int     @default(0)

  createdAt DateTime @default(now())

  logs AutomationLog[]

  @@index([ruleId])
  @@index([targetUserId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

model AutomationLog {
  id          String              @id @default(uuid())
  executionId String
  execution   AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  level   String // "info", "warn", "error"
  message String @db.Text
  context Json?

  createdAt DateTime @default(now())

  @@index([executionId])
  @@index([level])
  @@index([createdAt])
}

model ScheduledJob {
  id      String @id @default(uuid())
  type    String // job type identifier
  payload Json?

  status      ScheduledJobStatus @default(pending)
  runAt       DateTime
  startedAt   DateTime?
  completedAt DateTime?

  retryCount   Int     @default(0)
  maxRetries   Int     @default(3)
  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([runAt])
}

model NotificationTemplate {
  id       String  @id @default(uuid())
  tenantId String? // null = global
  key      String  @unique // e.g. "onboarding_reminder", "match_nudge"
  name     String
  type     String // "email", "in_app", "both"

  subject   String? // for email
  bodyHtml  String? @db.Text
  bodyText  String? @db.Text
  variables Json? // expected template variable names

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([tenantId])
  @@index([type])
}

model TenantAutomationConfig {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  automationsEnabled     Boolean @default(true)
  maxEmailsPerUserPerDay Int     @default(3)
  maxNotificationsPerDay Int     @default(10)
  quietHoursStart        Int? // 0-23 hour
  quietHoursEnd          Int? // 0-23 hour
  timezone               String  @default("UTC")

  onboardingAutomation   Boolean @default(true)
  matchingAutomation     Boolean @default(true)
  mentorshipAutomation   Boolean @default(true)
  communityAutomation    Boolean @default(true)
  billingAutomation      Boolean @default(true)
  reEngagementAutomation Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ── AI Matching Framework ─────────────────────────────────────────────────

enum MatchFeedbackType {
  accepted
  declined
  ignored
  not_relevant
  not_now
  better_fit_wanted
}

model MatchFeatureVector {
  id     String @id @default(uuid())
  userId String @unique

  features          Json // { skills:[], role, location, stage, industry, commitmentLevel }
  bioKeywords       String[] @default([])
  goalKeywords      String[] @default([])
  expertiseKeywords String[] @default([])

  avgResponseTimeHrs  Float?
  acceptanceRate      Float?
  profileQualityScore Float  @default(0)
  activityScore       Float  @default(0)

  modelVersion String   @default("1.0")
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([modelVersion])
}

model MatchInferenceLog {
  id           String @id @default(uuid())
  sourceUserId String
  targetUserId String

  roleScore         Float @default(0)
  skillScore        Float @default(0)
  locationScore     Float @default(0)
  industryScore     Float @default(0)
  semanticScore     Float @default(0)
  behavioralScore   Float @default(0)
  outcomePriorScore Float @default(0)
  finalScore        Float @default(0)

  modelVersion String @default("1.0")
  explanation  Json? // [{ dimension, label, weight }] for UI
  confidence   Float  @default(0.5)

  shownAt   DateTime?
  clickedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([sourceUserId, targetUserId, modelVersion])
  @@index([sourceUserId])
  @@index([targetUserId])
  @@index([finalScore])
  @@index([createdAt])
}

model MatchOutcome {
  id           String @id @default(uuid())
  sourceUserId String
  targetUserId String

  feedback            MatchFeedbackType
  connectionStarted   Boolean           @default(false)
  conversationStarted Boolean           @default(false)
  collaborationSignal Boolean           @default(false)

  sessionId    String?
  modelVersion String  @default("1.0")

  createdAt DateTime @default(now())

  @@unique([sourceUserId, targetUserId])
  @@index([sourceUserId])
  @@index([targetUserId])
  @@index([feedback])
  @@index([createdAt])
}

model UserBehaviorSignal {
  id     String @id @default(uuid())
  userId String

  signalType String // "profile_view", "match_view", "match_click", "message_sent", "connection_accepted", etc.
  targetId   String? // userId or entityId
  targetType String? // "user", "community", "event"

  value    Float @default(1.0)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([signalType])
  @@index([targetId])
  @@index([createdAt])
}

model MatchModelVersion {
  id          String  @id @default(uuid())
  version     String  @unique // "1.0", "1.1", "2.0"
  description String? @db.Text
  isActive    Boolean @default(false)

  avgAcceptanceRate Float?
  avgResponseRate   Float?
  sampleSize        Int       @default(0)
  evaluatedAt       DateTime?

  weights Json // { role: 0.4, skills: 0.25, location: 0.15, industry: 0.1, semantic: 0.05, behavioral: 0.05 }
  config  Json? // additional scoring config

  createdAt DateTime @default(now())

  @@index([isActive])
}

model MatchExperiment {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text

  status           String @default("draft") // "draft", "running", "paused", "completed"
  controlVersion   String
  treatmentVersion String
  trafficSplit     Float  @default(0.5)

  controlAcceptRate   Float?
  treatmentAcceptRate Float?
  controlConvRate     Float?
  treatmentConvRate   Float?

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ── Milestones / Collaboration Progress ───────────────────────────────────────

enum MilestoneStatus {
  todo
  in_progress
  blocked
  completed
  cancelled
}

model Milestone {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation("MilestonesOwned", fields: [ownerId], references: [id], onDelete: Cascade)

  // Optional collaborator (co-founder / partner context)
  collaboratorId String?
  collaborator   User?   @relation("MilestonesCollaborated", fields: [collaboratorId], references: [id], onDelete: SetNull)

  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(todo)
  priority    String          @default("medium") // "low" | "medium" | "high"
  category    String? // "product" | "fundraising" | "hiring" | "partnerships" | "growth" | "other"
  dueDate     DateTime?
  completedAt DateTime?
  progress    Int             @default(0) // 0-100 percent
  notes       String?         @db.Text

  // Optional link to a connection
  connectionRequestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([collaboratorId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

// ── Shortlist / Saved Profiles ─────────────────────────────────────────────────

model SavedProfile {
  id        String   @id @default(uuid())
  savedById String
  savedBy   User     @relation("SavedByUser", fields: [savedById], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserSaved", fields: [userId], references: [id], onDelete: Cascade)
  note      String? // optional private note
  createdAt DateTime @default(now())

  @@unique([savedById, userId])
  @@index([savedById])
  @@index([userId])
  @@index([createdAt])
}

// ── Endorsements ───────────────────────────────────────────────────────────────

model Endorsement {
  id          String   @id @default(uuid())
  fromUserId  String
  fromUser    User     @relation("EndorsementsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User     @relation("EndorsementsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  skill       String? // optional skill being endorsed (e.g., "Product Management")
  content     String   @db.Text // testimonial text
  relationship String? // e.g., "Co-founder", "Mentor", "Colleague"
  isPublic    Boolean  @default(true)
  isApproved  Boolean  @default(false) // recipient must approve before public display
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fromUserId, toUserId]) // one endorsement per pair
  @@index([toUserId, isApproved, isPublic])
  @@index([fromUserId])
  @@index([createdAt])
}

// Admin Audit Log for tracking all admin actions
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AdminAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)
  action     String // e.g., "user.ban", "report.resolve", "content.remove"
  entityType String // e.g., "user", "report", "event", "group"
  entityId   String? // ID of the affected entity
  meta       Json? // Additional context (reason, old/new values, etc.)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Research Workspace — FigJam-like research canvas for ecosystem intelligence
// ─────────────────────────────────────────────────────────────────────────────

model ResearchBoard {
  id           String                   @id @default(uuid())
  ownerId      String
  owner        User                     @relation("ResearchBoardsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  orgId        String?                  // optional org ownership
  title        String
  description  String?                  @db.Text
  visibility   ResearchBoardVisibility  @default(private)
  canvasState  Json?                    // viewport position, zoom level, etc.
  tags         String[]                 @default([])
  color        String?                  // board accent color
  icon         String?                  // board icon identifier
  isPinned     Boolean                  @default(false)
  isArchived   Boolean                  @default(false)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  nodes        ResearchNode[]
  connectors   ResearchConnector[]
  collaborators ResearchBoardCollaborator[]

  @@index([ownerId])
  @@index([orgId])
  @@index([visibility])
  @@index([createdAt])
}

model ResearchNode {
  id           String           @id @default(uuid())
  boardId      String
  board        ResearchBoard    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  type         ResearchNodeType
  title        String?
  content      String?          @db.Text // rich text content for notes, or extracted text
  url          String?          // for links, uploaded files, or external resources
  uploadId     String?          // reference to Upload if file-based
  upload       Upload?          @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  
  // Position and size on canvas
  posX         Float            @default(0)
  posY         Float            @default(0)
  width        Float            @default(280)
  height       Float            @default(200)
  zIndex       Int              @default(0)
  
  // Styling
  color        String?          // node background/accent color
  collapsed    Boolean          @default(false)
  locked       Boolean          @default(false)
  
  // Internal entity reference (for linking to CoFounderBay entities)
  refEntityType String?         // "user", "project", "opportunity", "group", etc.
  refEntityId   String?
  
  // Metadata
  metadata     Json?            // flexible metadata (page count, dimensions, etc.)
  tags         String[]         @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Connectors
  connectorsFrom ResearchConnector[] @relation("ConnectorFrom")
  connectorsTo   ResearchConnector[] @relation("ConnectorTo")

  // Comments / annotations
  comments       ResearchComment[]   @relation("NodeComments")

  @@index([boardId])
  @@index([type])
  @@index([uploadId])
}

model ResearchConnector {
  id           String        @id @default(uuid())
  boardId      String
  board        ResearchBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  fromNodeId   String
  fromNode     ResearchNode  @relation("ConnectorFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId     String
  toNode       ResearchNode  @relation("ConnectorTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  label        String?
  color        String?
  style        String?       @default("solid") // solid, dashed, dotted
  createdAt    DateTime      @default(now())

  @@index([boardId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

model ResearchBoardCollaborator {
  id        String        @id @default(uuid())
  boardId   String
  board     ResearchBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("ResearchBoardCollaborations", fields: [userId], references: [id], onDelete: Cascade)
  role      String        @default("viewer") // viewer, editor, admin
  addedAt   DateTime      @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

model ResearchComment {
  id        String       @id @default(uuid())
  nodeId    String
  node      ResearchNode @relation("NodeComments", fields: [nodeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("ResearchComments", fields: [authorId], references: [id], onDelete: Cascade)
  body      String       @db.Text
  resolved  Boolean      @default(false)
  posX      Float?       // optional anchor position on the canvas
  posY      Float?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([nodeId])
  @@index([authorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Startup Builder — Comprehensive Startup Formation & Execution OS
// ─────────────────────────────────────────────────────────────────────────────

enum BuilderWorkspaceStatus {
  draft
  active
  archived
  completed
}

enum BuilderWorkspaceVisibility {
  private
  team
  organization
  public
}

enum BuilderDocumentType {
  idea_core
  business_model_canvas
  market_analysis
  pitch_deck
  mvp_plan
  financial_plan
  technical_architecture
  prd
  branding_kit
  application
  custom
}

enum BuilderDocumentStatus {
  draft
  in_progress
  review
  approved
  archived
}

enum BuilderCollaboratorRole {
  owner
  editor
  commenter
  viewer
}

enum BuilderCommentStatus {
  open
  resolved
  archived
}

enum BuilderReviewStatus {
  pending
  approved
  changes_requested
  rejected
}

enum ApplicationTemplateType {
  yc
  techstars
  university_incubator
  grant
  custom
}

enum ReadinessDimension {
  team
  market
  product
  business
  funding
  execution
}

// ── Builder Workspace ─────────────────────────────────────────────────────────
// Central hub for a startup's formation documents and collaboration

model BuilderWorkspace {
  id          String                    @id @default(uuid())
  ownerId     String
  owner       User                      @relation("BuilderWorkspacesOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId    String?                   // Optional organization/tenant ownership
  
  // Basic info
  name        String
  slug        String                    @unique
  description String?                   @db.Text
  logoUrl     String?
  
  // Status & visibility
  status      BuilderWorkspaceStatus    @default(draft)
  visibility  BuilderWorkspaceVisibility @default(private)
  
  // Startup metadata
  startupName     String?
  industry        String?
  stage           String?               // "idea", "validation", "mvp", "growth", "scale"
  targetMarket    String?
  foundingDate    DateTime?
  
  // Settings
  settings        Json?                 // { aiProvider, defaultLanguage, exportFormat, etc. }
  
  // Timestamps
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  archivedAt  DateTime?
  
  // Relations
  documents       BuilderDocument[]
  collaborators   BuilderCollaborator[]
  readinessScores BuilderReadinessScore[]
  aiGenerations   BuilderAIGeneration[]
  versions        BuilderWorkspaceVersion[]
  applications    BuilderApplication[]
  activityLogs    BuilderActivityLog[]

  // Extended relations
  fundraisingRounds    FundraisingRound[]
  dataRoomDocuments    DataRoomDocument[]
  startupSnapshot      StartupSnapshot?
  techArchitecture     TechArchitecture?
  productRequirements  ProductRequirementDoc[]
  venturePortfolio     VenturePortfolio?       @relation("VenturePortfolioWorkspace")
  startupApplications  StartupApplication[]    @relation("WorkspaceApplications")
  workspaceComments    WorkspaceComment[]      @relation("WorkspaceComments")
  
  @@index([ownerId])
  @@index([tenantId])
  @@index([status])
  @@index([visibility])
  @@index([slug])
  @@index([createdAt])
}

// ── Builder Document ──────────────────────────────────────────────────────────
// Individual documents within a workspace (BMC, Pitch Deck, etc.)

model BuilderDocument {
  id            String                @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Document identity
  type          BuilderDocumentType
  title         String
  description   String?               @db.Text
  
  // Content (JSON structure varies by document type)
  content       Json                  // Full document content
  contentSchema String?               // Schema version for content structure
  
  // Status & metadata
  status        BuilderDocumentStatus @default(draft)
  completionPercent Int               @default(0)
  lastEditedById String?
  
  // AI generation tracking
  aiGenerated   Boolean               @default(false)
  aiModel       String?               // "gpt-4", "claude-3", etc.
  aiPromptHash  String?               // Hash of prompt used for generation
  
  // Versioning
  version       Int                   @default(1)
  isLatest      Boolean               @default(true)
  parentId      String?               // Previous version reference
  
  // Timestamps
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  publishedAt   DateTime?
  
  // Relations
  comments      BuilderComment[]
  reviews       BuilderReview[]
  versions      BuilderDocumentVersion[]
  sections      BuilderDocumentSection[]
  
  @@index([workspaceId])
  @@index([type])
  @@index([status])
  @@index([isLatest])
  @@index([createdAt])
}

// ── Builder Document Section ──────────────────────────────────────────────────
// Granular sections within a document for targeted editing and commenting

model BuilderDocumentSection {
  id            String          @id @default(uuid())
  documentId    String
  document      BuilderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Section identity
  sectionKey    String          // e.g., "value_propositions", "customer_segments", "slide_1"
  sectionTitle  String
  sortOrder     Int             @default(0)
  
  // Content
  content       Json            // Section-specific content
  
  // Status
  isComplete    Boolean         @default(false)
  confidence    Int?            // 0-100 confidence score
  
  // AI metadata
  aiGenerated   Boolean         @default(false)
  aiSuggestions Json?           // AI-suggested improvements
  
  // Timestamps
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // Relations
  comments      BuilderSectionComment[]
  
  @@unique([documentId, sectionKey])
  @@index([documentId])
  @@index([sectionKey])
}

// ── Builder Document Version ──────────────────────────────────────────────────
// Version history for documents

model BuilderDocumentVersion {
  id            String          @id @default(uuid())
  documentId    String
  document      BuilderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Version info
  version       Int
  versionLabel  String?         // "v1.0", "Draft 2", "Final", etc.
  
  // Content snapshot
  content       Json
  
  // Change tracking
  changesSummary String?        @db.Text
  changedById   String?
  
  // Timestamps
  createdAt     DateTime        @default(now())
  
  @@unique([documentId, version])
  @@index([documentId])
  @@index([createdAt])
}

// ── Builder Workspace Version ─────────────────────────────────────────────────
// Snapshot of entire workspace state

model BuilderWorkspaceVersion {
  id            String           @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Version info
  version       Int
  versionLabel  String?
  description   String?          @db.Text
  
  // Snapshot
  snapshot      Json             // Full workspace state
  
  // Metadata
  createdById   String?
  createdAt     DateTime         @default(now())
  
  @@unique([workspaceId, version])
  @@index([workspaceId])
  @@index([createdAt])
}

// ── Builder Collaborator ──────────────────────────────────────────────────────
// Team members with access to a workspace

model BuilderCollaborator {
  id            String                  @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User                    @relation("BuilderCollaborations", fields: [userId], references: [id], onDelete: Cascade)
  
  // Role & permissions
  role          BuilderCollaboratorRole @default(viewer)
  permissions   Json?                   // Fine-grained permissions override
  
  // Status
  isActive      Boolean                 @default(true)
  invitedById   String?
  invitedAt     DateTime                @default(now())
  acceptedAt    DateTime?
  lastAccessAt  DateTime?
  
  // Notification preferences
  notifyOnComments Boolean              @default(true)
  notifyOnChanges  Boolean              @default(false)
  notifyOnReviews  Boolean              @default(true)
  
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
}

// ── Builder Comment ───────────────────────────────────────────────────────────
// Comments on documents

model BuilderComment {
  id            String              @id @default(uuid())
  documentId    String
  document      BuilderDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                @relation("BuilderCommentsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  
  // Comment content
  body          String              @db.Text
  
  // Location (for inline comments)
  sectionKey    String?             // Which section the comment is on
  anchorText    String?             // Text being commented on
  anchorStart   Int?                // Character position start
  anchorEnd     Int?                // Character position end
  
  // Threading
  parentId      String?
  parent        BuilderComment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       BuilderComment[]    @relation("CommentReplies")
  
  // Status
  status        BuilderCommentStatus @default(open)
  resolvedById  String?
  resolvedAt    DateTime?
  
  // Timestamps
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  @@index([documentId])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
}

// ── Builder Section Comment ───────────────────────────────────────────────────
// Comments specifically on document sections

model BuilderSectionComment {
  id            String                 @id @default(uuid())
  sectionId     String
  section       BuilderDocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                   @relation("BuilderSectionCommentsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  
  // Comment content
  body          String                 @db.Text
  
  // Threading
  parentId      String?
  parent        BuilderSectionComment? @relation("SectionCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       BuilderSectionComment[] @relation("SectionCommentReplies")
  
  // Status
  status        BuilderCommentStatus   @default(open)
  resolvedById  String?
  resolvedAt    DateTime?
  
  // Timestamps
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  
  @@index([sectionId])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
}

// ── Builder Review ────────────────────────────────────────────────────────────
// Formal review requests for documents (mentor reviews, advisor feedback)

model BuilderReview {
  id            String              @id @default(uuid())
  documentId    String
  document      BuilderDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Review participants
  requestedById String
  requestedBy   User                @relation("BuilderReviewsRequested", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User                @relation("BuilderReviewsAssigned", fields: [reviewerId], references: [id], onDelete: Cascade)
  
  // Review content
  title         String?
  instructions  String?             @db.Text
  
  // Status
  status        BuilderReviewStatus @default(pending)
  feedback      String?             @db.Text
  rating        Int?                // 1-5 rating
  
  // Timestamps
  requestedAt   DateTime            @default(now())
  dueDate       DateTime?
  completedAt   DateTime?
  
  @@index([documentId])
  @@index([requestedById])
  @@index([reviewerId])
  @@index([status])
}

// ── Builder Readiness Score ───────────────────────────────────────────────────
// Readiness assessment across multiple dimensions

model BuilderReadinessScore {
  id            String             @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Score data
  dimension     ReadinessDimension
  score         Int                // 0-100
  maxScore      Int                @default(100)
  
  // Criteria breakdown
  criteria      Json               // [{ id, name, completed, weight, evidence }]
  
  // Status
  status        String             @default("needs-work") // "excellent", "good", "needs-work", "critical"
  
  // Recommendations
  recommendations Json?            // AI-generated recommendations
  blockers      Json?              // Critical blockers identified
  
  // Timestamps
  assessedAt    DateTime           @default(now())
  assessedById  String?
  
  // Version tracking
  version       Int                @default(1)
  
  @@unique([workspaceId, dimension, version])
  @@index([workspaceId])
  @@index([dimension])
  @@index([assessedAt])
}

// ── Builder AI Generation ─────────────────────────────────────────────────────
// Track AI generation requests and results

model BuilderAIGeneration {
  id            String           @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation("BuilderAIGenerations", fields: [userId], references: [id], onDelete: Cascade)
  
  // Request details
  documentType  BuilderDocumentType?
  sectionKey    String?
  prompt        String           @db.Text
  promptHash    String           // For caching/deduplication
  
  // AI configuration
  model         String           // "gpt-4", "claude-3-opus", etc.
  temperature   Float            @default(0.7)
  maxTokens     Int?
  
  // Response
  response      Json?            // Generated content
  tokensUsed    Int?
  latencyMs     Int?
  
  // Status
  status        String           @default("pending") // "pending", "completed", "failed", "cached"
  errorMessage  String?          @db.Text
  
  // Cost tracking
  costCents     Int?             // Cost in cents
  
  // Timestamps
  createdAt     DateTime         @default(now())
  completedAt   DateTime?
  
  @@index([workspaceId])
  @@index([userId])
  @@index([documentType])
  @@index([promptHash])
  @@index([status])
  @@index([createdAt])
}

// ── Builder Application ───────────────────────────────────────────────────────
// Accelerator/grant applications generated from workspace data

model BuilderApplication {
  id            String                  @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Application identity
  templateType  ApplicationTemplateType
  templateName  String                  // "Y Combinator W25", "Techstars NYC", etc.
  
  // Content
  answers       Json                    // { questionId: answer }
  
  // Status
  status        String                  @default("draft") // "draft", "in_progress", "completed", "submitted"
  completionPercent Int                 @default(0)
  
  // Submission tracking
  deadline      DateTime?
  submittedAt   DateTime?
  submissionUrl String?
  
  // Timestamps
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  
  @@index([workspaceId])
  @@index([templateType])
  @@index([status])
  @@index([deadline])
}

// ── Builder Template ──────────────────────────────────────────────────────────
// Reusable templates for documents and applications

model BuilderTemplate {
  id            String              @id @default(uuid())
  
  // Template identity
  type          BuilderDocumentType
  name          String
  description   String?             @db.Text
  
  // Content
  content       Json                // Template structure
  schema        String?             // Schema version
  
  // Categorization
  category      String?             // "startup", "saas", "marketplace", etc.
  industry      String?
  stage         String?             // "idea", "seed", "series-a", etc.
  
  // Visibility
  isPublic      Boolean             @default(false)
  isOfficial    Boolean             @default(false) // Platform-provided template
  tenantId      String?             // Tenant-specific template
  createdById   String?
  
  // Usage tracking
  usageCount    Int                 @default(0)
  rating        Float?              // Average rating
  
  // Timestamps
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  @@index([type])
  @@index([isPublic])
  @@index([isOfficial])
  @@index([tenantId])
  @@index([category])
}

// ── Builder Application Template ──────────────────────────────────────────────
// Templates for accelerator/grant applications

model BuilderApplicationTemplate {
  id            String                  @id @default(uuid())
  
  // Template identity
  templateType  ApplicationTemplateType
  name          String                  // "Y Combinator", "Techstars", etc.
  description   String?                 @db.Text
  
  // Questions
  questions     Json                    // [{ id, question, maxLength, tips, required }]
  
  // Metadata
  deadline      String?                 // "Rolling", "March 15", etc.
  website       String?
  
  // Visibility
  isActive      Boolean                 @default(true)
  
  // Timestamps
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  
  @@index([templateType])
  @@index([isActive])
}

// ── Builder Export ────────────────────────────────────────────────────────────
// Track document exports (PDF, PPTX, etc.)

model BuilderExport {
  id            String          @id @default(uuid())
  documentId    String?
  workspaceId   String?
  userId        String
  user          User            @relation("BuilderExports", fields: [userId], references: [id], onDelete: Cascade)
  
  // Export details
  format        String          // "pdf", "pptx", "docx", "json"
  fileName      String
  fileUrl       String?
  fileSizeBytes Int?
  
  // Status
  status        String          @default("pending") // "pending", "processing", "completed", "failed"
  errorMessage  String?
  
  // Timestamps
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  expiresAt     DateTime?       // When the file will be deleted
  
  @@index([userId])
  @@index([documentId])
  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

// ── Builder Activity Log ──────────────────────────────────────────────────────
// Audit trail for workspace activities

model BuilderActivityLog {
  id            String           @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?            @relation("BuilderActivities", fields: [userId], references: [id], onDelete: SetNull)
  
  // Activity details
  action        String           // "document.created", "document.edited", "comment.added", etc.
  entityType    String?          // "document", "comment", "review", etc.
  entityId      String?
  
  // Change details
  changes       Json?            // { field: { old, new } }
  metadata      Json?            // Additional context
  
  // Timestamps
  createdAt     DateTime         @default(now())
  
  @@index([workspaceId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Multi-Role / Persona System — Users can have multiple role facets
// ─────────────────────────────────────────────────────────────────────────────

model UserRoleFacet {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  roleType    UserRoleType
  scope       RoleFacetScope @default(global)
  scopeId     String?        // tenantId, workspaceId, communityId, programId depending on scope
  
  isActive    Boolean        @default(true)
  isPrimary   Boolean        @default(false) // Primary role for dashboard routing
  
  // Role-specific metadata
  metadata    Json?          // Additional role-specific data
  
  // Verification
  isVerified  Boolean        @default(false)
  verifiedAt  DateTime?
  verifiedBy  String?        // Admin userId who verified
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  @@unique([userId, roleType, scope, scopeId])
  @@index([userId])
  @@index([roleType])
  @@index([scope])
  @@index([isActive])
  @@index([isPrimary])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization System — Business entities (separate from Tenant for white-label)
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id              String           @id @default(uuid())
  tenantId        String?          // Optional link to tenant for white-label
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User             @relation("OrganizationsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  
  // Identity
  type            OrganizationType
  name            String
  slug            String           @unique
  displayName     String?
  description     String?          @db.Text
  tagline         String?
  
  // Contact & Web
  website         String?
  email           String?
  phone           String?
  
  // Branding
  logoUrl         String?
  coverImageUrl   String?
  primaryColor    String?          // Hex color
  
  // Location
  country         String?
  city            String?
  address         String?
  timezone        String?
  
  // Focus areas
  industries      String[]         @default([])
  stages          String[]         @default([]) // Startup stages they work with
  focusAreas      String[]         @default([])
  
  // Status
  isVerified      Boolean          @default(false)
  isActive        Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  
  // Settings
  settings        Json?            // Organization-specific settings
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Relations
  memberships       OrganizationMembership[]
  programs          Program[]
  mentorPool        OrganizationMentor[]
  venturePortfolios VenturePortfolio[]
  
  @@index([type])
  @@index([slug])
  @@index([tenantId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
}

model OrganizationMembership {
  id              String                 @id @default(uuid())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role            OrganizationMemberRole @default(member)
  title           String?                // Job title within org
  department      String?
  
  isActive        Boolean                @default(true)
  joinedAt        DateTime               @default(now())
  invitedBy       String?                // userId of inviter
  
  // Permissions override
  permissions     Json?                  // Fine-grained permissions
  
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([isActive])
}

model OrganizationMentor {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Mentor assignment details
  expertiseAreas  String[]     @default([])
  maxMentees      Int?
  currentMentees  Int          @default(0)
  
  isActive        Boolean      @default(true)
  assignedAt      DateTime     @default(now())
  assignedBy      String?
  
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Program System — Cohorts, Accelerators, Courses, Competitions
// ─────────────────────────────────────────────────────────────────────────────

model Program {
  id                  String        @id @default(uuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId            String?
  createdById         String
  createdBy           User          @relation("ProgramsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  
  // Identity
  name                String
  slug                String
  description         String?       @db.Text
  shortDescription    String?
  
  // Type & Status
  programType         ProgramType
  status              ProgramStatus @default(draft)
  
  // Dates
  startDate           DateTime?
  endDate             DateTime?
  applicationDeadline DateTime?
  
  // Capacity
  capacity            Int?
  currentParticipants Int           @default(0)
  
  // Visibility
  isPublic            Boolean       @default(true)
  isFeatured          Boolean       @default(false)
  
  // Branding
  logoUrl             String?
  coverImageUrl       String?
  
  // Content
  curriculum          Json?         // Program curriculum/milestones
  requirements        Json?         // Application requirements
  benefits            Json?         // What participants get
  
  // Settings
  settings            Json?         // Program-specific settings
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  // Relations
  participants        ProgramParticipant[]
  milestones          ProgramMilestone[]
  
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([tenantId])
  @@index([programType])
  @@index([status])
  @@index([isPublic])
  @@index([startDate])
}

model ProgramParticipant {
  id          String                   @id @default(uuid())
  programId   String
  program     Program                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId      String?                  // Individual participant
  user        User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?                  // Link to BuilderWorkspace for startup teams
  
  // Role & Status
  role        ProgramParticipantRole   @default(participant)
  status      ProgramParticipantStatus @default(applied)
  
  // Progress
  progress    Int                      @default(0) // 0-100
  score       Float?                   // Evaluation score
  rank        Int?                     // Ranking within cohort
  
  // Application
  application Json?                    // Application answers
  appliedAt   DateTime?
  acceptedAt  DateTime?
  
  // Notes
  notes       String?                  @db.Text
  feedback    Json?                    // Mentor/judge feedback
  
  joinedAt    DateTime                 @default(now())
  completedAt DateTime?
  
  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  @@index([workspaceId])
  @@index([role])
  @@index([status])
}

model ProgramMilestone {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  title       String
  description String?  @db.Text
  dueDate     DateTime?
  sortOrder   Int      @default(0)
  
  // Requirements
  requirements Json?   // What needs to be completed
  deliverables Json?   // Expected deliverables
  
  isRequired  Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([programId])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Stakeholder Profiles — Mentor, Investor, Service Provider
// ─────────────────────────────────────────────────────────────────────────────

model MentorProfile {
  id                  String                  @id @default(uuid())
  userId              String                  @unique
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Professional Info
  headline            String?
  bio                 String?                 @db.Text
  expertiseSummary    String?                 @db.Text
  
  // Expertise
  industries          String[]                @default([])
  startupStages       String[]                @default([])
  skills              String[]                @default([])
  specializations     String[]                @default([])
  
  // Experience
  yearsExperience     Int?
  mentoringSince      DateTime?
  totalMentees        Int                     @default(0)
  totalSessions       Int                     @default(0)
  
  // Availability
  availabilityStatus  MentorAvailabilityStatus @default(available)
  hoursPerWeek        Int?
  sessionFormats      String[]                @default([]) // "video", "in_person", "async"
  sessionDuration     Int                     @default(30) // minutes
  timezone            String?
  
  // Pricing
  isFree              Boolean                 @default(true)
  hourlyRate          Int?                    // in cents
  currency            String                  @default("USD")
  
  // Ratings
  avgRating           Float?
  totalReviews        Int                     @default(0)
  
  // Verification
  isVerified          Boolean                 @default(false)
  verifiedAt          DateTime?
  
  // Status
  isActive            Boolean                 @default(true)
  isAcceptingRequests Boolean                 @default(true)
  
  // Settings
  preferences         Json?                   // Mentee preferences
  settings            Json?
  
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  
  @@index([userId])
  @@index([availabilityStatus])
  @@index([isActive])
  @@index([isVerified])
  @@index([avgRating])
}

model InvestorProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Investor Type
  investorType    InvestorType
  
  // Firm Info
  firmName        String?
  firmRole        String?
  firmWebsite     String?
  firmLogoUrl     String?
  
  // Investment Criteria
  checkSizeMin    Int?         // in USD
  checkSizeMax    Int?
  
  // Focus
  industries      String[]     @default([])
  stages          String[]     @default([]) // "pre-seed", "seed", "series-a"
  geographies     String[]     @default([])
  businessModels  String[]     @default([]) // "b2b", "b2c", "marketplace"
  
  // Track Record
  portfolioCount  Int?
  exitsCount      Int?
  investingSince  DateTime?
  
  // Bio
  bio             String?      @db.Text
  investmentThesis String?     @db.Text
  
  // Availability
  isActivelyScouting Boolean   @default(true)
  acceptsColdOutreach Boolean  @default(false)
  
  // Verification
  isVerified      Boolean      @default(false)
  verifiedAt      DateTime?
  
  // Status
  isActive        Boolean      @default(true)
  isPublic        Boolean      @default(true)
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([userId])
  @@index([investorType])
  @@index([isActive])
  @@index([isVerified])
  @@index([isActivelyScouting])
}

model ServiceProviderProfile {
  id              String              @id @default(uuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Service Type
  serviceType     ServiceProviderType
  
  // Company Info
  companyName     String?
  companyWebsite  String?
  companyLogoUrl  String?
  
  // Services
  services        Json?               // [{ name, description, pricing }]
  headline        String?
  description     String?             @db.Text
  
  // Focus
  industries      String[]            @default([])
  startupStages   String[]            @default([])
  
  // Pricing
  pricingModel    String?             // "hourly", "project", "retainer", "equity"
  startingPrice   Int?                // in cents
  currency        String              @default("USD")
  
  // Track Record
  clientsServed   Int?
  yearsInBusiness Int?
  
  // Ratings
  avgRating       Float?
  totalReviews    Int                 @default(0)
  
  // Verification
  isVerified      Boolean             @default(false)
  verifiedAt      DateTime?
  
  // Status
  isActive        Boolean             @default(true)
  isAcceptingClients Boolean          @default(true)
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  @@index([userId])
  @@index([serviceType])
  @@index([isActive])
  @@index([isVerified])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enhanced Mentorship System — Relationships, Sessions, Requests
// ─────────────────────────────────────────────────────────────────────────────

model MentorshipRelationship {
  id              String    @id @default(uuid())
  mentorId        String
  mentor          User      @relation("MentorshipAsMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId        String
  mentee          User      @relation("MentorshipAsMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  
  // Context
  workspaceId     String?   // Optional link to startup workspace
  programId       String?   // If part of a program
  organizationId  String?   // If through an organization
  
  // Status
  status          String    @default("active") // "pending", "active", "paused", "completed", "terminated"
  
  // Goals
  goals           Json?     // Mentorship goals
  focusAreas      String[]  @default([])
  
  // Progress
  totalSessions   Int       @default(0)
  lastSessionAt   DateTime?
  
  // Notes
  mentorNotes     String?   @db.Text
  menteeNotes     String?   @db.Text
  
  // Dates
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  nextSessionAt   DateTime?
  
  // Relations
  sessions        MentorshipSession[]
  goals           MentorshipGoal[]
  
  @@unique([mentorId, menteeId])
  @@index([mentorId])
  @@index([menteeId])
  @@index([workspaceId])
  @@index([programId])
  @@index([status])
}

model MentorshipSession {
  id                  String               @id @default(uuid())
  relationshipId      String
  relationship        MentorshipRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  mentorId            String
  mentor              User                 @relation("SessionAsMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId            String
  mentee              User                 @relation("SessionAsMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  
  // Session Details
  title               String?
  description         String?              @db.Text
  
  // Scheduling
  scheduledAt         DateTime
  duration            Int                  @default(30) // minutes
  timezone            String?
  
  // Meeting
  meetingType         String               @default("video") // "video", "in_person", "phone", "chat"
  meetingUrl          String?
  meetingLocation     String?
  
  // Status
  status              String               @default("scheduled") // "scheduled", "confirmed", "in_progress", "completed", "cancelled", "no_show"
  
  // Notes
  agenda              String?              @db.Text
  mentorNotes         String?              @db.Text
  menteeNotes         String?              @db.Text
  actionItems         Json?                // [{ task, assignee, dueDate, completed }]
  
  // Feedback
  mentorRating        Int?                 // 1-5
  menteeRating        Int?                 // 1-5
  mentorFeedback      String?              @db.Text
  menteeFeedback      String?              @db.Text
  
  // Recording
  recordingUrl        String?
  transcriptUrl       String?
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  completedAt         DateTime?
  
  @@index([relationshipId])
  @@index([mentorId])
  @@index([menteeId])
  @@index([scheduledAt])
  @@index([status])
}

model MentorRequest {
  id              String   @id @default(uuid())
  requesterId     String
  requester       User     @relation("MentorRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  mentorId        String
  mentor          User     @relation("MentorRequestsReceived", fields: [mentorId], references: [id], onDelete: Cascade)
  
  // Context
  workspaceId     String?  // Optional link to startup workspace
  programId       String?  // If through a program
  
  // Request Details
  message         String   @db.Text
  goals           String?  @db.Text
  focusAreas      String[] @default([])
  
  // Availability
  preferredFormat String?  // "video", "in_person", "async"
  preferredTimes  Json?    // Preferred meeting times
  
  // Status
  status          String   @default("pending") // "pending", "accepted", "declined", "expired"
  
  // Response
  responseMessage String?  @db.Text
  respondedAt     DateTime?
  
  createdAt       DateTime @default(now())
  expiresAt       DateTime?
  
  @@unique([requesterId, mentorId])
  @@index([requesterId])
  @@index([mentorId])
  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// User Preferences & Matching Profile
// ─────────────────────────────────────────────────────────────────────────────

model UserPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Startup Preferences
  startupStageInterest  String[] @default([]) // "idea", "validation", "mvp", "growth"
  roleInterest          String[] @default([]) // "founder", "cofounder", "advisor", "investor"
  commitmentLevel       String?  // "full_time", "part_time", "advisory", "flexible"
  
  // Work Preferences
  remotePreference      String?  // "remote", "hybrid", "onsite", "flexible"
  geographyPreference   String[] @default([])
  timezonePreference    String?
  
  // Industry & Domain
  industryPreferences   String[] @default([])
  excludedIndustries    String[] @default([])
  
  // Work Style
  workStyle             Json?    // { pace, communication, decisionMaking, etc. }
  values                String[] @default([])
  
  // Risk & Equity
  riskTolerance         String?  // "low", "medium", "high"
  equityExpectation     String?  // "none", "small", "significant", "majority"
  
  // Notification Preferences
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  matchNotifications    Boolean  @default(true)
  messageNotifications  Boolean  @default(true)
  
  // Privacy
  profileVisibility     String   @default("public") // "public", "connections", "private"
  showInMatching        Boolean  @default(true)
  showInSearch          Boolean  @default(true)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([userId])
}

model MatchProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // What I'm looking for
  lookingForRoles     String[] @default([]) // "cofounder", "mentor", "investor", "advisor"
  lookingForSkills    String[] @default([])
  lookingForIndustries String[] @default([])
  
  // What I offer
  offeredRoles        String[] @default([])
  offeredSkills       String[] @default([])
  offeredExperience   String?  @db.Text
  
  // Startup context
  hasStartup          Boolean  @default(false)
  startupStage        String?
  startupIndustry     String?
  
  // Availability
  isActivelyLooking   Boolean  @default(true)
  availableFrom       DateTime?
  
  // Exclusions
  excludedConditions  String[] @default([])
  
  // Visibility
  visibilityEnabled   Boolean  @default(true)
  
  // Matching weights (user can adjust importance)
  weights             Json?    // { skills: 0.3, industry: 0.2, location: 0.2, ... }
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([userId])
  @@index([isActivelyLooking])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Match Suggestions
// ─────────────────────────────────────────────────────────────────────────────

enum MatchSuggestionStatus {
  pending
  viewed
  saved
  dismissed
  connected
}

model MatchSuggestion {
  id            String                @id @default(uuid())
  sourceUserId  String
  sourceUser    User                  @relation("MatchSuggestionsAsSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  targetUserId  String
  targetUser    User                  @relation("MatchSuggestionsAsTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  
  // Scores (0-100)
  overallScore     Float
  confidenceScore  Float              @default(0.0)
  skillScore       Float              @default(0.0)
  industryScore    Float              @default(0.0)
  locationScore    Float              @default(0.0)
  stageScore       Float              @default(0.0)
  valuesScore      Float              @default(0.0)
  
  // Explanation
  reasons          String[]           @default([])
  sharedStrengths  String[]           @default([])
  frictionPoints   String[]           @default([])
  whyThisMatch     String?            @db.Text
  
  // Status
  status           MatchSuggestionStatus @default(pending)
  viewedAt         DateTime?
  savedAt          DateTime?
  dismissedAt      DateTime?
  dismissReason    String?
  
  // Meta
  algorithmVersion String?            @default("v1")
  generatedAt      DateTime           @default(now())
  expiresAt        DateTime?
  
  @@unique([sourceUserId, targetUserId])
  @@index([sourceUserId, status])
  @@index([targetUserId])
  @@index([overallScore])
  @@index([generatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature Flags
// ─────────────────────────────────────────────────────────────────────────────

enum FeatureFlagScope {
  global
  tenant
  user
  role
  plan
}

model FeatureFlag {
  id           String           @id @default(uuid())
  key          String           @unique // e.g. "ai_matching_v2", "builder_financials"
  name         String
  description  String?
  scope        FeatureFlagScope @default(global)
  isEnabled    Boolean          @default(false)
  
  // Rollout percentage (0-100), null = all
  rolloutPct   Int?
  
  // Targeting
  targetRole   String?          // If scope = role
  planKeys     String[]         @default([]) // If scope = plan: ["starter", "pro"]
  enabledFor   String[]         @default([]) // explicit user/tenant ids
  
  // Metadata
  tags         String[]         @default([])
  expiresAt    DateTime?
  createdById  String?
  
  // Tenant override FK handled via TenantFeatureFlag
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  
  tenantOverrides TenantFeatureFlag[]

  @@index([key])
  @@index([isEnabled])
  @@index([scope])
  @@index([scope, isEnabled])
}

model TenantFeatureFlag {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  isEnabled     Boolean
  overriddenAt  DateTime    @default(now())

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Plan Tiers
// ─────────────────────────────────────────────────────────────────────────────

enum PlanBillingInterval {
  monthly
  quarterly
  annual
  lifetime
}

model PlanTier {
  id                  String              @id @default(uuid())
  key                 String              @unique // "free", "pro", "team", "enterprise"
  name                String
  tagline             String?
  description         String?             @db.Text
  
  // Pricing
  priceCents          Int                 @default(0)
  currency            String              @default("USD")
  billingInterval     PlanBillingInterval @default(monthly)
  stripePriceId       String?             @unique
  stripeProductId     String?
  
  // Limits
  maxWorkspaces       Int?                // null = unlimited
  maxTeamMembers      Int?
  maxStorageMb        Int?
  maxAiGenerations    Int?                // per month
  maxMentorSessions   Int?                // per month
  
  // Features (flags as JSON object)
  features            Json                @default("{}")
  
  // Status
  isActive            Boolean             @default(true)
  isPublic            Boolean             @default(true)
  sortOrder           Int                 @default(0)
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  @@index([isActive, isPublic])
  @@index([sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// Webhooks
// ─────────────────────────────────────────────────────────────────────────────

enum WebhookStatus {
  active
  paused
  failed
  revoked
}

model Webhook {
  id          String        @id @default(uuid())
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  url         String
  secret      String        // HMAC signing secret (hashed)
  events      String[]      @default([]) // ["user.created", "connection.accepted", ...]
  
  status      WebhookStatus @default(active)
  
  // Stats
  totalSent   Int           @default(0)
  failCount   Int           @default(0)
  lastSentAt  DateTime?
  lastErrorAt DateTime?
  lastError   String?       @db.Text
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  deliveries  WebhookDelivery[]

  @@index([tenantId])
  @@index([status])
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  
  eventType   String
  payload     Json
  statusCode  Int?
  response    String?  @db.Text
  duration    Int?     // ms
  
  success     Boolean  @default(false)
  sentAt      DateTime @default(now())
  
  @@index([webhookId, sentAt])
  @@index([eventType])
  @@index([success])
}

// ─────────────────────────────────────────────────────────────────────────────
// Achievements & Gamification
// ─────────────────────────────────────────────────────────────────────────────

enum AchievementCategory {
  onboarding
  matching
  collaboration
  builder
  community
  mentoring
  milestone
  program
  streak
  platform
}

model AchievementDefinition {
  id           String              @id @default(uuid())
  key          String              @unique // "first_match", "workspace_complete", etc.
  name         String
  description  String
  category     AchievementCategory
  iconUrl      String?
  points       Int                 @default(10)
  
  // Trigger condition (stored as JSON rule definition)
  condition    Json
  
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  
  userAchievements UserAchievement[]

  @@index([category])
  @@index([isActive])
}

model UserAchievement {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId   String
  achievement     AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  unlockedAt      DateTime              @default(now())
  seenAt          DateTime?
  
  // Context in which it was unlocked
  contextType     String?               // "workspace", "program", "connection"
  contextId       String?

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
  @@index([achievementId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Announcements & System Messages
// ─────────────────────────────────────────────────────────────────────────────

enum AnnouncementAudience {
  all
  founders
  mentors
  investors
  orgs
  tenant
  program
}

model Announcement {
  id          String               @id @default(uuid())
  tenantId    String?
  tenant      Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  title       String
  body        String               @db.Text
  ctaLabel    String?
  ctaUrl      String?
  
  audience    AnnouncementAudience @default(all)
  targetRole  String?
  
  // Scheduling
  startsAt    DateTime             @default(now())
  expiresAt   DateTime?
  
  isDismissable Boolean            @default(true)
  isPinned      Boolean            @default(false)
  
  createdById String?
  createdAt   DateTime             @default(now())
  
  dismissals  AnnouncementDismissal[]

  @@index([tenantId, startsAt])
  @@index([audience])
  @@index([isPinned])
}

model AnnouncementDismissal {
  userId         String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime     @default(now())

  @@id([userId, announcementId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// User Onboarding Progress
// ─────────────────────────────────────────────────────────────────────────────

model OnboardingProgress {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Step completion flags
  profileComplete   Boolean @default(false)
  skillsAdded       Boolean @default(false)
  photoUploaded     Boolean @default(false)
  preferencesSet    Boolean @default(false)
  firstConnection   Boolean @default(false)
  firstMessage      Boolean @default(false)
  workspaceCreated  Boolean @default(false)
  firstMilestone    Boolean @default(false)
  
  // Computed
  completionPct     Int     @default(0)
  
  // Timestamps
  completedAt       DateTime?
  lastStepAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([completionPct])
}

// ─────────────────────────────────────────────────────────────────────────────
// API Keys (for external integrations)
// ─────────────────────────────────────────────────────────────────────────────

enum ApiKeyStatus {
  active
  revoked
  expired
}

model ApiKey {
  id          String       @id @default(uuid())
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  
  name        String
  keyHash     String       @unique  // SHA-256 hash of the actual key
  keyPrefix   String       // First 8 chars for display: "cfb_xxxx"
  
  scopes      String[]     @default([]) // ["read:matches", "write:workspaces", ...]
  status      ApiKeyStatus @default(active)
  
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  @@index([tenantId])
  @@index([status])
  @@index([keyPrefix])
}

// ─────────────────────────────────────────────────────────────────────────────
// Fundraising — Round Tracker, Investor Pipeline, Data Room
// ─────────────────────────────────────────────────────────────────────────────

enum FundraisingRoundType {
  pre_seed
  seed
  series_a
  series_b
  series_c
  bridge
  safe
  convertible_note
  grant
  revenue_based
  other
}

enum FundraisingRoundStatus {
  planning
  active
  closing
  closed
  cancelled
}

enum InvestorLeadStatus {
  prospect
  contacted
  meeting
  due_diligence
  committed
  passed
  inactive
}

enum DataRoomDocCategory {
  pitch
  financials
  legal
  product
  market
  team
  traction
  other
}

enum DataRoomDocStatus {
  draft
  ready
  shared
  archived
}

model FundraisingRound {
  id               String                 @id @default(uuid())
  workspaceId      String?
  workspace        BuilderWorkspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User                   @relation("FundraisingRoundOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name             String                 // "Seed Round", "Series A"
  roundType        FundraisingRoundType   @default(seed)
  status           FundraisingRoundStatus @default(planning)

  targetAmount     Decimal?               @db.Decimal(18, 2)
  raisedAmount     Decimal                @default(0) @db.Decimal(18, 2)
  currency         String                 @default("USD")

  preMoneyValuation Decimal?              @db.Decimal(18, 2)
  equityOffered    Decimal?               @db.Decimal(5, 4) // e.g. 0.15 = 15%

  leadInvestorName String?
  leadInvestorId   String?                // Link to platform investor profile

  closingDate      DateTime?
  announcedAt      DateTime?

  description      String?                @db.Text
  terms            Json?                  // Term sheet key points

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  leads            InvestorPipelineLead[]
  documents        DataRoomDocument[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([status])
  @@index([ownerId, status])
}

model InvestorPipelineLead {
  id               String             @id @default(uuid())
  roundId          String
  round            FundraisingRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  addedById        String
  addedBy          User               @relation("PipelineLeadsAdded", fields: [addedById], references: [id], onDelete: Cascade)

  // Investor info
  investorName     String
  investorFirm     String?
  investorEmail    String?
  investorLinkedIn String?
  investorType     String?            // "angel", "vc", "syndicate", "family_office", "scout"
  isVerifiedOnPlatform Boolean        @default(false)
  platformUserId   String?            // Link to CoFounderBay investor profile

  // Stage
  status           InvestorLeadStatus @default(prospect)
  checkSizeMin     Decimal?           @db.Decimal(18, 2)
  checkSizeMax     Decimal?           @db.Decimal(18, 2)
  committedAmount  Decimal?           @db.Decimal(18, 2)
  currency         String             @default("USD")

  // Tracking
  lastContactAt    DateTime?
  nextFollowUpAt   DateTime?
  meetingScheduledAt DateTime?
  notes            String?            @db.Text

  introducedVia    String?            // How they were introduced
  warmth           String?            // "cold", "warm", "hot"

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([roundId])
  @@index([addedById])
  @@index([roundId, status])
  @@index([status])
}

model DataRoomDocument {
  id               String              @id @default(uuid())
  roundId          String?
  round            FundraisingRound?   @relation(fields: [roundId], references: [id], onDelete: SetNull)
  workspaceId      String?
  workspace        BuilderWorkspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedBy       User                @relation("DataRoomDocsUploaded", fields: [uploadedById], references: [id], onDelete: Cascade)

  name             String
  description      String?
  category         DataRoomDocCategory @default(other)
  status           DataRoomDocStatus   @default(draft)
  isRequired       Boolean             @default(false)

  // File
  fileUrl          String?
  fileName         String?
  fileMimeType     String?
  fileSizeBytes    Int?

  // Access control
  isPublic         Boolean             @default(false)
  sharedWithLeads  Boolean             @default(false)
  viewCount        Int                 @default(0)

  version          Int                 @default(1)
  notes            String?             @db.Text

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  accessLogs       DataRoomAccessLog[]

  @@index([roundId])
  @@index([workspaceId])
  @@index([uploadedById])
  @@index([roundId, category])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Coaching Sessions (distinct from Mentoring — process-oriented accountability)
// ─────────────────────────────────────────────────────────────────────────────

enum CoachingSessionStatus {
  scheduled
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum CoachingSessionType {
  accountability
  clarity
  team_dynamics
  execution
  strategy
  wellbeing
  other
}

model CoachingSession {
  id              String               @id @default(uuid())
  coachId         String
  coach           User                 @relation("CoachingSessions_Coach", fields: [coachId], references: [id], onDelete: Cascade)
  clientId        String
  client          User                 @relation("CoachingSessions_Client", fields: [clientId], references: [id], onDelete: Cascade)

  workspaceId     String?              // Optional workspace context
  programId       String?              // If part of org program

  sessionType     CoachingSessionType  @default(accountability)
  title           String?
  agenda          String?              @db.Text

  scheduledAt     DateTime
  durationMinutes Int                  @default(45)
  timezone        String?

  meetingUrl      String?
  meetingLocation String?

  status          CoachingSessionStatus @default(scheduled)

  // Session notes
  coachNotes      String?              @db.Text
  clientNotes     String?              @db.Text
  actionItems     Json?                // [{ task, owner, dueDate, done }]
  keyInsights     String?              @db.Text

  // Feedback
  coachRating     Int?                 // 1–5
  clientRating    Int?                 // 1–5
  coachFeedback   String?              @db.Text
  clientFeedback  String?              @db.Text

  // Next session
  nextSessionAt   DateTime?
  followUpNotes   String?              @db.Text

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  completedAt     DateTime?

  @@index([coachId])
  @@index([clientId])
  @@index([scheduledAt])
  @@index([status])
  @@index([coachId, status])
  @@index([clientId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Expert / Advisor Reviews (domain-specific structured feedback)
// ─────────────────────────────────────────────────────────────────────────────

enum ExpertReviewStatus {
  requested
  accepted
  in_progress
  submitted
  declined
  expired
}

enum ExpertReviewType {
  pitch_deck
  business_model
  financial_model
  legal_structure
  market_analysis
  go_to_market
  technical_architecture
  product_strategy
  general
}

model ExpertReview {
  id               String            @id @default(uuid())
  requesterId      String
  requester        User              @relation("ExpertReviews_Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  expertId         String
  expert           User              @relation("ExpertReviews_Expert", fields: [expertId], references: [id], onDelete: Cascade)

  workspaceId      String?           // Workspace/startup context

  reviewType       ExpertReviewType  @default(general)
  status           ExpertReviewStatus @default(requested)

  // Request
  requestMessage   String?           @db.Text
  documentsJson    Json?             // List of documents/URLs shared

  // Review output
  summaryFeedback  String?           @db.Text
  strengthsJson    Json?             // [{ area, comment }]
  improvementsJson Json?             // [{ area, recommendation }]
  scoreOverall     Int?              // 1–10
  scoresByArea     Json?             // { "market": 7, "team": 9, ... }

  // Compensation
  isPaid           Boolean           @default(false)
  agreedFee        Decimal?          @db.Decimal(10, 2)
  currency         String            @default("USD")

  // Timing
  requestedAt      DateTime          @default(now())
  acceptedAt       DateTime?
  dueDate          DateTime?
  submittedAt       DateTime?
  
  rating           Int?              // Requester rates review 1-5
  ratingComment    String?           @db.Text

  @@index([requesterId])
  @@index([expertId])
  @@index([workspaceId])
  @@index([status])
  @@index([reviewType, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service Offers & Inquiries (Marketplace — structured provider offerings)
// ─────────────────────────────────────────────────────────────────────────────

enum ServiceOfferStatus {
  draft
  active
  paused
  archived
}

enum ServicePricingModel {
  fixed
  hourly
  monthly_retainer
  project_based
  equity
  free
  contact_for_pricing
}

enum ServiceInquiryStatus {
  open
  in_discussion
  accepted
  declined
  completed
  cancelled
}

model ServiceOffer {
  id                String             @id @default(uuid())
  providerId        String
  provider          User               @relation("ServiceOffers_Provider", fields: [providerId], references: [id], onDelete: Cascade)

  title             String
  description       String             @db.Text
  shortTagline      String?

  category          String             // "legal", "finance", "design", "dev", "marketing", "strategy", etc.
  subcategory       String?
  tags              String[]           @default([])

  pricingModel      ServicePricingModel @default(contact_for_pricing)
  priceFrom         Decimal?           @db.Decimal(10, 2)
  priceTo           Decimal?           @db.Decimal(10, 2)
  currency          String             @default("USD")
  pricingNotes      String?

  deliverables      Json?              // [{ item, description }]
  deliveryDays      Int?
  revisionsIncluded Int?

  // Targeting
  targetStartupStages String[]         @default([])  // "idea", "mvp", "growth"
  targetIndustries    String[]         @default([])

  // Credibility
  portfolioUrls     String[]           @default([])
  testimonialsJson  Json?              // [{ name, role, comment, rating }]
  completedProjects Int                @default(0)

  status            ServiceOfferStatus @default(draft)
  isFeatured        Boolean            @default(false)
  viewCount         Int                @default(0)
  inquiryCount      Int                @default(0)
  avgRating         Decimal?           @db.Decimal(3, 2)
  reviewCount       Int                @default(0)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  inquiries         ServiceInquiry[]

  @@index([providerId])
  @@index([status])
  @@index([category])
  @@index([isFeatured])
  @@index([providerId, status])
}

model ServiceInquiry {
  id               String              @id @default(uuid())
  offerId          String
  offer            ServiceOffer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clientId         String
  client           User                @relation("ServiceInquiries_Client", fields: [clientId], references: [id], onDelete: Cascade)
  providerId       String
  provider         User                @relation("ServiceInquiries_Provider", fields: [providerId], references: [id], onDelete: Cascade)

  workspaceId      String?
  status           ServiceInquiryStatus @default(open)

  message          String              @db.Text
  budgetEstimate   Decimal?            @db.Decimal(10, 2)
  currency         String              @default("USD")
  timelineExpected String?

  // Response
  responseMessage  String?             @db.Text
  agreedScope      String?             @db.Text
  agreedPrice      Decimal?            @db.Decimal(10, 2)

  // Outcome
  rating           Int?                // 1–5
  reviewComment    String?             @db.Text

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  resolvedAt       DateTime?

  @@index([offerId])
  @@index([clientId])
  @@index([providerId])
  @@index([status])
  @@index([providerId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Startup Snapshot — Investor-Facing Summary (VC/Scout Scouting Feed)
// ─────────────────────────────────────────────────────────────────────────────

model StartupSnapshot {
  id               String   @id @default(uuid())
  workspaceId      String   @unique
  workspace        BuilderWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User     @relation("StartupSnapshots", fields: [ownerId], references: [id], onDelete: Cascade)

  // Computed / cached headline data
  startupName      String?
  tagline          String?
  industry         String?
