  rewardGranted Boolean        @default(false)
  rewardedAt    DateTime?

  registeredAt  DateTime?
  convertedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([referrerId])
  @@index([refereeId])
  @@index([code])
  @@index([status])
  @@index([referrerId, status])
}

