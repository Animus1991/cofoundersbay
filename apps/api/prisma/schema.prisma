  // Overall snapshot score (0–100)
  overallScore  Int

  // Per-dimension scores (0–100 each, mirrors ReadinessDimension enum)
  teamScore      Int      @default(0)
  marketScore    Int      @default(0)
  productScore   Int      @default(0)
  businessScore  Int      @default(0)
  fundingScore   Int      @default(0)
  executionScore Int      @default(0)

  // Context
  assessmentType String   @default("auto") // "auto", "manual", "ai_assisted"
  notes          String?  @db.Text

  // Benchmark comparison data
  industryBenchmark Int?  // Average score for same industry/stage cohort
  stagePercentile   Int?  // Percentile vs startups at same stage (0–100)

  // Triggered by (e.g., after completing a criterion or workspace edit)
  triggeredBy   String?  // "criterion_update", "workspace_save", "manual", "scheduled"

  snapshotAt    DateTime @default(now())

