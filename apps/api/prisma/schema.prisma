// ─────────────────────────────────────────────────────────────────────────────
// User Reputation Score — Computed contribution & trust score per user
// ─────────────────────────────────────────────────────────────────────────────

model UserReputationScore {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation("ReputationScore", fields: [userId], references: [id], onDelete: Cascade)

  // Overall score (0–100)
  overallScore        Int      @default(0)

  // Dimension scores (0–100 each)
  profileCompleteness Int      @default(0)
  networkActivity     Int      @default(0)
  communityContrib    Int      @default(0)
  mentorActivity      Int      @default(0)
  workspaceActivity   Int      @default(0)
  endorsementsScore   Int      @default(0)

  // Trust signals
  isVerified          Boolean  @default(false)
  verifiedAt          DateTime?
  verificationMethod  String?  // "manual", "linkedin", "email_domain"
  trustTier           Int      @default(1) // 1-5 trust tiers

  // Badges earned
  badges              String[] @default([])

  // Leaderboard
  globalRank          Int?
  weeklyDelta         Int      @default(0) // score change this week

  calculatedAt        DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([overallScore])
  @@index([globalRank])
  @@index([isVerified])
  @@index([trustTier])
