// CoFounderBay — source of truth
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  founder
  mentor
  investor
  org
  admin
}

enum ConversationType {
  direct
  group
}

enum UploadKind {
  avatar
  message_attachment
  event_attachment
}

enum EventType {
  meetup
  webinar
  workshop
  demo_day
  networking
  other
}

enum RsvpStatus {
  going
  interested
  not_going
}

enum MeetingType {
  video
  in_person
  chat
}

enum BookingStatus {
  requested
  confirmed
  cancelled
  completed
}

enum NotificationType {
  message
  connection_request
  connection_accepted
  event_rsvp
  system
  billing
}

enum ConnectionStatus {
  pending
  accepted
  declined
  blocked
}

enum ReportType {
  spam
  harassment
  fake
  inappropriate
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  paused
  canceled
  unpaid
  incomplete
  incomplete_expired
}

enum UserModerationStatus {
  active
  suspended
  banned
}

enum InviteStatus {
  pending
  accepted
  expired
  cancelled
}

enum GroupPrivacy {
  public
  private
  secret
}

enum GroupMemberRole {
  owner
  admin
  moderator
  member
}

model User {
  id                     String         @id @default(uuid())
  email                  String         @unique
  slug                   String         @unique
  passwordHash           String?
  role                   Role           @default(founder)
  moderationStatus       UserModerationStatus @default(active)
  emailVerified              Boolean        @default(false)
  emailVerificationToken     String?        @unique
  emailVerificationExpires   DateTime?
  hasCompletedOnboarding     Boolean        @default(false)
  lastSeenAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([role, moderationStatus])
  @@index([lastSeenAt])
  @@index([createdAt])

  refreshTokens          RefreshToken[]
  profile                Profile?

  // OAuth providers
  googleId               String?        @unique
  linkedinId             String?        @unique
  
  // Two-Factor Authentication
  twoFactorSecret        String?
  twoFactorEnabled       Boolean        @default(false)
  twoFactorBackupCodes   String[]       @default([])

  // Messaging
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]

  // Uploads
  uploads Upload[]

  // Social graph
  connectionsSent     ConnectionRequest[] @relation("ConnectionsSent")
  connectionsReceived ConnectionRequest[] @relation("ConnectionsReceived")

  // Events
  eventsCreated Event[]     @relation("EventsCreated")
  eventRsvps    EventRsvp[]

  // Mentoring
  mentorAvailabilities   MentorAvailability[]
  mentorBookingsAsMentor MentorBooking[]      @relation("MentorBookingsMentor")
  mentorBookingsAsMentee MentorBooking[]      @relation("MentorBookingsMentee")

  // Notifications
  notifications Notification[]

  // Moderation
  reportsFiled    Report[] @relation("ReportsFiled")
  reportsAgainst  Report[] @relation("ReportsAgainst")
  reportsResolved Report[] @relation("ReportsResolvedBy")

  // Billing
  subscription Subscription?

  // Polls
  pollsCreated Poll[]      @relation("PollsCreated")
  pollVotes    PollVote[]  @relation("PollVotes")

  // Jobs
  jobPostings  JobPosting[] @relation("JobPostingsCreated")

  // Invites
  invitesSent     Invite[] @relation("InvitesSent")
  invitesReceived Invite[] @relation("InvitesReceived")

  // Groups
  groupsCreated      Group[]            @relation("GroupsCreated")
  groupMemberships   GroupMember[]
  groupPosts         GroupPost[]
  groupPostComments  GroupPostComment[]
  groupPostReactions GroupPostReaction[]

  // Phase 2: Analytics & Data
  profileViewsAsViewer ProfileView[]       @relation("ProfileViewsAsViewer")
  activities           UserActivity[]
  opportunities        Opportunity[]
  learningResources    LearningResource[]
  marketplaceServices  MarketplaceService[]
  cohortsOrganized     Cohort[]

  // Admin
  adminAuditLogs       AdminAuditLog[]     @relation("AdminAuditLogs")
  cohortMemberships    CohortMember[]
}

model Profile {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  headline        String?
  bio             String?        @db.Text
  location        String?
  timezone        String?
  languages       Json? // string[] e.g. ["en", "el"]
  avatarUrl       String?
  rolePayload     Json? // role-specific: industry, stage, expertiseAreas, checkSize, etc.
  visibilityRules Json? // { email?: "public"|"connections"|"private", ... }
  
  // Organization-specific fields
  tagline         String?
  website         String?
  mission         String?        @db.Text
  industry        String?
  focus           String?        // comma-separated focus areas
  size            String?        // organization size
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  skills          ProfileSkill[]
  
  // Phase 2: Analytics
  views           ProfileView[]

  @@index([location])
  @@index([createdAt])
}

model Skill {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  category  String? // e.g. "technical", "business", "design"
  createdAt DateTime       @default(now())
  profiles  ProfileSkill[]
}

model ProfileSkill {
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     String? // "beginner" | "intermediate" | "expert" (optional)
  createdAt DateTime @default(now())

  @@id([profileId, skillId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  deviceInfo String?
}

model Conversation {
  id            String                    @id @default(uuid())
  type          ConversationType          @default(direct)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessageAt DateTime?
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  isPinned       Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isMuted        Boolean      @default(false)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String              @id @default(uuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String              @db.Text
  createdAt      DateTime            @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  readAt         DateTime?
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadId  String?
  upload    Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  url       String
  mimeType  String?
  fileName  String?
  sizeBytes Int?
}

model Upload {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         UploadKind
  key          String
  url          String
  mimeType     String?
  originalName String?
  sizeBytes    Int?
  createdAt    DateTime   @default(now())

  messageAttachments MessageAttachment[]

  @@index([userId])
  @@index([kind])
}

model ConnectionRequest {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  requester   User             @relation("ConnectionsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  message     String?          @db.Text
  status      ConnectionStatus @default(pending)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

model Event {
  id            String      @id @default(uuid())
  creatorId     String
  creator       User        @relation("EventsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  title         String
  description   String?     @db.Text
  type          EventType   @default(networking)
  startAt       DateTime
  endAt         DateTime?
  timezone      String?
  location      String?
  isOnline      Boolean     @default(false)
  meetingUrl    String?
  capacity      Int?
  coverImageUrl String?
  isFeatured    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rsvps         EventRsvp[]

  @@index([startAt])
  @@index([creatorId])
  @@index([isFeatured])
}

model EventRsvp {
  eventId     String
  userId      String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RsvpStatus @default(going)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  checkedInAt DateTime?

  @@id([eventId, userId])
  @@index([userId])
}

model MentorAvailability {
  id        String   @id @default(uuid())
  mentorId  String
  mentor    User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  weekday   Int // 0-6
  startTime String // "09:00"
  endTime   String
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentorId])
}

model MentorBooking {
  id                    String        @id @default(uuid())
  mentorId              String
  mentor                User          @relation("MentorBookingsMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId              String
  mentee                User          @relation("MentorBookingsMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  startAt               DateTime
  endAt                 DateTime
  timezone              String?
  meetingType           MeetingType   @default(video)
  meetingUrl            String?
  notes                 String?       @db.Text
  status                BookingStatus @default(requested)
  priceCents            Int?
  currency              String?       @default("USD")
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([mentorId, startAt])
  @@index([menteeId, startAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  meta      Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Report {
  id             String       @id @default(uuid())
  type           ReportType
  status         ReportStatus @default(pending)
  reporterId     String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId     String
  reported       User         @relation("ReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)
  reason         String       @db.Text
  context        Json?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?        @relation("ReportsResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reportedId, status])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(incomplete)
  priceId              String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Poll {
  id        String       @id @default(uuid())
  creatorId String
  creator   User         @relation("PollsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  question  String       @db.Text
  isActive  Boolean      @default(true)
  endsAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  options   PollOption[]
  votes     PollVote[]

  @@index([isActive, createdAt])
}

model PollOption {
  id     String @id @default(uuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String @db.Text
  sortOrder Int @default(0)
  votes  PollVote[]

  @@index([pollId])
}

model PollVote {
  id         String      @id @default(uuid())
  pollId     String
  optionId   String
  userId     String
  poll       Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option     PollOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user       User        @relation("PollVotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
}

model JobPosting {
  id          String   @id @default(uuid())
  creatorId   String
  creator     User     @relation("JobPostingsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  role        String?  // e.g. "Founder", "Technical Co-Founder"
  location    String?
  isRemote    Boolean  @default(false)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, createdAt])
  @@index([isFeatured])
}

model Invite {
  id           String       @id @default(uuid())
  senderId     String
  sender       User         @relation("InvitesSent", fields: [senderId], references: [id], onDelete: Cascade)
  email        String
  message      String?      @db.Text
  status       InviteStatus @default(pending)
  acceptedById String?
  acceptedBy   User?        @relation("InvitesReceived", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([email])
  @@index([status])
}

// Groups/Communities System
model Group {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  description    String?       @db.Text
  avatarUrl      String?
  coverImageUrl  String?
  privacy        GroupPrivacy  @default(public)
  category       String?
  tags           Json?
  rules          Json?
  isFeatured     Boolean       @default(false)
  createdById    String
  createdBy      User          @relation("GroupsCreated", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  members        GroupMember[]
  posts          GroupPost[]
  events         GroupEvent[]

  @@index([slug])
  @@index([privacy])
  @@index([category])
  @@index([createdAt])
  @@index([isFeatured])
}

model GroupMember {
  id        String          @id @default(uuid())
  groupId   String
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupMemberRole @default(member)
  joinedAt  DateTime        @default(now())
  
  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupPost {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String    @db.Text
  mediaUrls Json?
  isPinned  Boolean   @default(false)
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  comments  GroupPostComment[]
  reactions GroupPostReaction[]

  @@index([groupId, createdAt])
  @@index([authorId])
}

model GroupPostComment {
  id        String    @id @default(uuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String    @db.Text
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
}

model GroupPostReaction {
  id        String    @id @default(uuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model GroupEvent {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime?
  location    String?
  isVirtual   Boolean  @default(false)
  meetingUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupId, startDate])
}

// ============================================
// Phase 2: Data Layer Completion & Analytics
// ============================================

enum ProfileViewSource {
  direct
  search
  recommendation
  group
  event
  external
}

enum UserActivityType {
  profile_view
  connection_sent
  connection_accepted
  message_sent
  event_created
  event_rsvp
  group_joined
  post_created
  login
  profile_updated
}

enum OpportunityType {
  job
  cofounder
  investment
  partnership
  mentorship
  other
}

enum LearningResourceType {
  article
  video
  course
  podcast
  book
  tool
  template
}

enum LearningDifficulty {
  beginner
  intermediate
  advanced
}

enum MarketplaceCategory {
  legal
  finance
  marketing
  development
  design
  consulting
  coaching
  other
}

// Track profile views for analytics
model ProfileView {
  id         String            @id @default(uuid())
  profileId  String
  profile    Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  viewerId   String?           // nullable for anonymous views
  viewer     User?             @relation("ProfileViewsAsViewer", fields: [viewerId], references: [id], onDelete: SetNull)
  source     ProfileViewSource @default(direct)
  referrer   String?           // URL or context
  createdAt  DateTime          @default(now())

  @@index([profileId, createdAt])
  @@index([viewerId])
}

// Track user activity for analytics and recommendations
model UserActivity {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserActivityType
  entityId  String?          // ID of related entity (profile, event, group, etc.)
  entityType String?         // "profile", "event", "group", etc.
  meta      Json?            // Additional context
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([entityId])
}

// Opportunities (jobs, co-founder searches, investments, etc.)
model Opportunity {
  id          String          @id @default(uuid())
  title       String
  description String?         @db.Text
  type        OpportunityType @default(job)
  company     String?
  location    String?
  isRemote    Boolean         @default(false)
  url         String?         // External application URL
  tags        Json?           // string[]
  deadline    DateTime?
  isActive    Boolean         @default(true)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, isActive])
  @@index([createdById])
  @@index([createdAt])
}

// Learning resources (articles, videos, courses, etc.)
model LearningResource {
  id          String              @id @default(uuid())
  title       String
  description String?             @db.Text
  type        LearningResourceType @default(article)
  category    String?             // "fundraising", "product", "marketing", etc.
  url         String
  author      String?
  duration    Int?                // minutes for video/course
  difficulty  LearningDifficulty  @default(beginner)
  tags        Json?               // string[]
  imageUrl    String?
  isFeatured  Boolean             @default(false)
  isActive    Boolean             @default(true)
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([type, isActive])
  @@index([category])
  @@index([isFeatured])
  @@index([createdAt])
}

// Marketplace services (legal, finance, marketing, etc.)
model MarketplaceService {
  id           String              @id @default(uuid())
  title        String
  description  String?             @db.Text
  category     MarketplaceCategory @default(other)
  providerName String
  providerLogo String?
  pricing      String?             // "Free", "$99/mo", "Custom", etc.
  contactUrl   String?
  websiteUrl   String?
  tags         Json?               // string[]
  isFeatured   Boolean             @default(false)
  isActive     Boolean             @default(true)
  createdById  String
  createdBy    User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([category, isActive])
  @@index([isFeatured])
  @@index([createdAt])
}

// Cohorts/Programs for B2B functionality
model Cohort {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?        @db.Text
  organizerId String
  organizer   User           @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int?
  isPublic    Boolean        @default(true)
  tags        Json?          // string[]
  imageUrl    String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  members     CohortMember[]

  @@index([slug])
  @@index([organizerId])
  @@index([isPublic, isActive])
}

model CohortMember {
  id        String   @id @default(uuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("participant") // "participant", "mentor", "organizer"
  joinedAt  DateTime @default(now())

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
}

// Admin Audit Log for tracking all admin actions
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AdminAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)
  action     String   // e.g., "user.ban", "report.resolve", "content.remove"
  entityType String   // e.g., "user", "report", "event", "group"
  entityId   String?  // ID of the affected entity
  meta       Json?    // Additional context (reason, old/new values, etc.)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
