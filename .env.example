# CoFounderBay — copy to .env and fill values

# Database (match docker-compose or your host)
DATABASE_URL="postgresql://cofounderbay:cofounderbay_dev@localhost:5432/cofounderbay"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="cofounderbay_meili_dev_key_change_in_prod"

# API (NestJS)
API_PORT=3001
API_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="change-me-min-32-chars-for-access-token"
JWT_REFRESH_SECRET="change-me-min-32-chars-for-refresh-token"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Web (Next.js) — for API base URL from browser
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Web base URL (used in emails + Stripe return URLs)
WEB_BASE_URL="http://localhost:3000"

# SMTP (optional, for transactional emails)
# If SMTP_HOST/PORT/FROM are set, message notification emails will be sent via queue (Redis) when possible.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CoFounderBay <no-reply@cofounderbay.local>"

# Stripe (optional, for subscriptions / mentoring payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# Optional: OAuth (add when implementing)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Optional: S3-compatible storage (later)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
